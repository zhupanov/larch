+++ b/repairHistoryReferences.js
@@ -0,0 +1,51 @@
+const migration = require('./migrationState')
+const { render, continuation } = require('./migrationContent')
+const { discussion, inlineContext, assertReplayComplete, assertReplayAudited } = require('./historyCorpus')
+
+const repairComment = async (item, state) => {
+  if (migration.isDeferred(item.number) || (item.kind === 'review' && item.record.state === 'PENDING')) return { deferred: true }
+  const extra = item.kind === 'pull-comment' ? inlineContext(item.record, item.number, state.commentUrls) : ''
+  const rendered = await render(item.record, item.kind, state.objects, state.commentUrls, extra)
+  const pieces = [{ key: item.key, body: rendered.body, identity: rendered.identity }]
+  for (const [index, text] of rendered.parts.entries()) pieces.push({ key: item.key + ':part-' + (index + 1), ...continuation(item.record, item.kind, text, index, rendered.parts.length) })
+  let changed = 0
+  for (const piece of pieces) {
+    const saved = state.comments[piece.key]
+    if (!saved || saved.status !== 'verified') throw new Error('Missing imported discussion mapping: ' + piece.key)
+    let remote = await migration.call('GET', '/issues/comments/' + saved.targetId)
+    if (remote.id !== saved.targetId || !String(remote.body || '').startsWith(piece.identity) || Number(remote.issue_url.split('/').pop()) !== saved.targetNumber) throw new Error('Destination comment identity changed: ' + piece.key)
+    const desired = migration.sha256(migration.normalize(piece.body))
+    const observed = migration.sha256(migration.normalize(remote.body))
+    if (desired !== observed) {
+      if (observed !== saved.bodySha256) throw new Error('Destination comment was edited outside the migration: ' + saved.targetUrl)
+      await migration.audit({ action: 'repair-comment-reference-intent', key: piece.key, targetId: saved.targetId, beforeSha256: observed, afterSha256: desired })
+      await migration.call('PATCH', '/issues/comments/' + saved.targetId, { body: piece.body })
+      remote = await migration.call('GET', '/issues/comments/' + saved.targetId)
+      migration.verifyBody(remote, piece.body)
+      changed++
+    }
+    saved.bodySha256 = desired
+    saved.referencesVerifiedAt = new Date().toISOString()
+    if (item.kind === 'review' && state.reviews[item.record.id]) state.reviews[item.record.id] = { ...saved, originalState: item.record.state }
+    await migration.save()
+  }
+  return { changed, verified: pieces.length }
+}
+
+const main = async () => {
+  const state = migration.state()
+  await assertReplayAudited(state)
+  const records = await assertReplayComplete(state)
+  const items = await discussion(new Set(records.map(record => record.number)))
+  const totals = { verified: 0, changed: 0, deferred: 0 }
+  for (const [index, item] of items.entries()) {
+    const result = await repairComment(item, state)
+    for (const key of Object.keys(totals)) totals[key] += Number(result[key] || 0)
+    if ((index + 1) % 100 === 0) console.log('Verified references for ' + (index + 1) + '/' + items.length + ' discussion records')
+  }
+  state.referenceRepair = { ...totals, completedAt: new Date().toISOString() }
+  await migration.save()
+  console.log(JSON.stringify(state.referenceRepair))
+}
+if (require.main === module) migration.run('repairHistoryReferences', main)
+module.exports = { main, repairComment }
