+const fs = require('fs-extra')
+const path = require('node:path')
+const config = require('./config')
+const migration = require('./migrationState')
+const { discussion, assertReplayComplete, assertReplayAudited } = require('./historyCorpus')
+const { loadCollection } = require('./historyCollection')
+const { fileCoverage } = require('./historyFiles')
+
+const sourceSlug = config.source.org + '/' + config.source.repo
+const sourceBase = 'https://github.com/' + sourceSlug
+const destination = mapping => mapping?.status === 'verified' ? {
+  status: 'verified-copy', number: mapping.targetNumber, url: mapping.targetUrl,
+  kind: mapping.targetKind, issueId: mapping.targetIssueId,
+  ...(mapping.archivalException ? { archivalException: mapping.archivalException } : {}),
+  ...(mapping.titleException ? { titleException: mapping.titleException } : {}),
+} : { status: 'deferred-live-work', leaf: 9 }
+
+const composePullArchive = (raw, links, mapping, discussionMapping) => {
+  if (raw.sourceNumber !== links.sourceNumber || raw.sourceUrl !== links.sourceUrl) throw new Error('Linked-issue record has a different source PR identity')
+  if (raw.pull.number !== raw.sourceNumber || raw.originalIssue.number !== raw.sourceNumber) throw new Error('PR archival identity mismatch')
+  if (!mapping && !migration.isDeferred(raw.sourceNumber)) throw new Error('Unexplained absent destination PR')
+  const coverage = fileCoverage({ reportedFiles: raw.pull.changed_files, files: raw.files, gitFileHistory: raw.gitFileHistory })
+  if (raw.pull.commits !== raw.commits.length && !raw.gitCommitHistory) throw new Error('Incomplete retained commit history')
+  return {
+    schemaVersion: 1, source: sourceSlug, sourceNumber: raw.sourceNumber, sourceUrl: raw.sourceUrl,
+    destination: destination(mapping),
+    fidelity: 'Attributed copy. Native author, creation time, reviews, CI runs, and merged state are not recreated. Original values and available event history are retained below.',
+    original: raw, closingIssues: links.closingIssues, discussionMapping,
+    coverage: { commits: raw.commits.length, gitCommitFallback: Boolean(raw.gitCommitHistory), ...coverage, fileEntries: raw.files.length, gitFileFallback: Boolean(raw.gitFileHistory), issueComments: raw.issueComments.length, inlineComments: raw.inlineComments.length, reviews: raw.reviews.length, availableCheckRuns: raw.checks.length, availableStatuses: raw.statuses.length, availableTimelineEvents: raw.timeline.length, closingIssues: links.closingIssues.length },
+  }
+}
+
+const addLink = (index, link) => {
+  const key = [link.kind, link.from, link.to].join('\n')
+  if (index.seen.has(key)) return
+  index.seen.add(key)
+  index.links.push(link)
+  ;(index.outgoing[link.from] = index.outgoing[link.from] || []).push(link)
+  ;(index.incoming[link.to] = index.incoming[link.to] || []).push(link)
+}
+const hasDeferredReference = text => /https:\/\/github\.com\/character-ai\/larch\/(?:issues|pull)\/9076\b|character-ai\/larch#9076\b|(?<![\w/])#9076\b/.test(String(text || ''))
+
+const main = async () => {
+  const state = migration.state()
+  await assertReplayAudited(state)
+  const records = await assertReplayComplete(state)
+  if (!state.referenceRepair?.completedAt || !state.nativeRelations?.completedAt) throw new Error('Reference and native-relation restoration must finish before archive assembly')
+  const root = config.source.repo
+  const { relations } = await loadCollection(records)
+  if (!await fs.pathExists(root + '/history/linked-issues/complete.json')) throw new Error('Source linked-issue history collection is incomplete')
+  const selected = new Set(records.map(record => record.number))
+  const items = await discussion(selected)
+  const byNumber = new Map()
+  for (const item of items) {
+    const group = byNumber.get(item.number) || []
+    group.push(item)
+    byNumber.set(item.number, group)
+  }
+  const archive = root + (config.target.repo === 'larch' ? '/archive' : '/rehearsal-archive')
+  await fs.ensureDir(archive)
+  const index = { schemaVersion: 1, source: state.source, target: state.target, builtAt: new Date().toISOString(), bySourceNumber: {}, byDestinationNumber: {} }
+  const graph = { seen: new Set(), links: [], outgoing: {}, incoming: {} }
+  const deferred = { sourceNumber: 9076, sourceUrl: sourceBase + '/pull/9076', leaf: 9, archivePath: 'pulls/9076.json', referenceOccurrences: [], nativeRelations: state.nativeRelations.archival.filter(edge => edge.sourceNumber === 9076 || edge.relatedNumber === 9076) }
+  const totals = { objects: 0, pullRequests: 0, issues: 0, deferredPullRequests: 0, archivalPullFallbacks: 0, discussion: {}, commits: 0, fileEntries: 0, uniqueFiles: 0, completeFiles: 0, reviews: 0, inlineComments: 0, availableCheckRuns: 0, availableStatuses: 0, availableTimelineEvents: 0, closingIssues: 0, exceptions: [] }
+  for (const source of records) {
+    const mapping = state.objects[source.number]
+    if (!mapping && !migration.isDeferred(source.number)) throw new Error('Unmapped archive object: ' + source.number)
+    if (mapping?.titleException) totals.exceptions.push({ sourceNumber: source.number, reason: mapping.titleException.reason, completeTitlesRetainedIn: mapping.titleException.completeTitlesRetainedIn })
+    const isPull = Boolean(source.pull_request)
+    const relative = (isPull ? 'pulls/' : 'issues/') + source.number + '.json'
+    const discussionItems = byNumber.get(source.number) || []
+    const discussionMapping = discussionItems.map(item => {
+      const target = state.comments[item.key]
