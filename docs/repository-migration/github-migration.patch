@@ -0,0 +1,35 @@
+const assert = require('node:assert/strict')
+const { test } = require('node:test')
+const { parseGitFiles, fileCoverage, destinationFileCoverage } = require('./historyFiles')
+
+const files = Array.from({ length: 3000 }, (_, i) => ({ filename: 'logs/' + i, status: 'removed', sha: 'abc', additions: 0, deletions: 2, changes: 2 }))
+const gitFileHistory = Array.from({ length: 17280 }, (_, i) => 'D\0logs/' + i + '\0').join('')
+const source = { pull: { changed_files: 0 }, files, gitFileHistory }
+
+test('a zero provider count on a capped large diff retains and verifies all Git paths', () => {
+  const result = fileCoverage({ reportedFiles: 0, files, gitFileHistory })
+  assert.equal(result.providerReportedFiles, 0)
+  assert.equal(result.providerCounterException, true)
+  assert.equal(result.completeFiles, 17280)
+  assert.equal(result.uniqueFiles, 3000)
+  assert.equal(destinationFileCoverage(source, { changed_files: 0 }, files).completeFiles, 17280)
+  assert.equal(destinationFileCoverage(source, { changed_files: 17280 }, [...files].reverse()).destinationProviderCounterException, false)
+})
+
+test('the fallback rejects incomplete, inconsistent, or altered source and destination evidence', () => {
+  assert.throws(() => fileCoverage({ reportedFiles: 0, files }), /Incomplete retained/)
+  assert.throws(() => fileCoverage({ reportedFiles: 0, files: files.slice(0, 2999), gitFileHistory }), /capped API/)
+  assert.throws(() => fileCoverage({ reportedFiles: 17281, files, gitFileHistory }), /positive provider/)
+  assert.throws(() => fileCoverage({ reportedFiles: 0, files: [{ ...files[0], status: 'added' }, ...files.slice(1)], gitFileHistory }), /disagrees with retained Git/)
+  assert.throws(() => fileCoverage({ reportedFiles: 0, files: [{ ...files[0], filename: 'missing' }, ...files.slice(1)], gitFileHistory }), /disagrees with retained Git/)
+  assert.throws(() => destinationFileCoverage(source, { changed_files: 0 }), /read-back/)
+  assert.throws(() => destinationFileCoverage(source, { changed_files: 0 }, [{ ...files[0], sha: 'def' }, ...files.slice(1)]), /differs from the source/)
+  assert.throws(() => destinationFileCoverage({ pull: { changed_files: 1 }, files: files.slice(0, 1) }, { changed_files: 0 }), /coverage differs/)
+})
+
+test('NUL-delimited Git history retains unusual paths and rename identity', () => {
+  assert.deepEqual(parseGitFiles('R100\0old\tname\0new\nname\0'), [{ code: 'R', filename: 'new\nname', previous_filename: 'old\tname' }])
+  assert.throws(() => parseGitFiles('D\0unterminated'), /NUL terminated/)
+  assert.throws(() => parseGitFiles('R100\0old\0'), /rename destination/)
+  assert.throws(() => parseGitFiles('D\0same\0D\0same\0'), /Duplicate paths/)
+})
