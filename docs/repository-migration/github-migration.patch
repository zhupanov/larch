@@ -0,0 +1,55 @@
+const fs = require('fs-extra')
+const { execFileSync } = require('node:child_process')
+const config = require('./config')
+const migration = require('./migrationState')
+const request = require('./migrationRequest')
+
+const root = config.source.repo + '/history/linked-issues'
+const query = async (key, expression) => {
+  const cache = root + '/raw/' + key + '.json'
+  if (await fs.pathExists(cache)) return fs.readJson(cache)
+  const queryFile = root + '/queries/' + key + '.json'
+  await migration.atomicJson(queryFile, { query: 'query MigrationHistoricalClosingIssues { repository(owner: "character-ai", name: "larch") { ' + expression + ' } rateLimit { remaining resetAt } }' })
+  let response
+  try {
+    response = JSON.parse(execFileSync('gh', ['api', 'graphql', '--input', queryFile], { encoding: 'utf8', env: { ...process.env, GH_TOKEN: config.source.token }, stdio: ['ignore', 'pipe', 'pipe'], maxBuffer: 32 * 1024 * 1024 }))
+  } catch (error) { throw new Error('Read-only closing-issue query failed: ' + request.safeError(String(error.stderr || error.message))) }
+  if (response.errors?.length || !response.data?.repository) throw new Error('Closing-issue query returned incomplete data')
+  await migration.atomicJson(cache, response)
+  if (response.data.rateLimit?.remaining < 5) {
+    const delay = Math.max(0, Date.parse(response.data.rateLimit.resetAt) - Date.now() + 2000)
+    if (delay) await new Promise(resolve => setTimeout(resolve, delay))
+  }
+  return response
+}
+const field = (number, cursor) => {
+  if (!Number.isSafeInteger(number) || number < 1) throw new Error('Invalid PR number')
+  return 'p' + number + ': pullRequest(number: ' + number + ') { number url closingIssuesReferences(first: 100' + (cursor ? ', after: ' + JSON.stringify(cursor) : '') + ') { totalCount pageInfo { hasNextPage endCursor } nodes { id number url repository { nameWithOwner } } } }'
+}
+const main = async () => {
+  if (config.enableWrites || process.env.MIGRATION_SELECTION) throw new Error('Closing-issue collection requires the complete read-only source configuration')
+  const pulls = (await migration.issueFiles()).filter(issue => issue.pull_request)
+  let links = 0
+  for (let offset = 0; offset < pulls.length; offset += 50) {
+    const batch = pulls.slice(offset, offset + 50)
+    const response = await query('batch-' + offset, batch.map(pull => field(pull.number)).join('\n'))
+    for (const pull of batch) {
+      const result = response.data.repository['p' + pull.number]
+      if (result?.number !== pull.number || result.url !== pull.html_url) throw new Error('Closing-issue query identity differs: ' + pull.number)
+      let page = result.closingIssuesReferences
+      const issues = [...page.nodes]
+      let pageNumber = 1
+      while (page.pageInfo.hasNextPage) {
+        const next = await query('pull-' + pull.number + '-page-' + (++pageNumber), field(pull.number, page.pageInfo.endCursor))
+        page = next.data.repository['p' + pull.number].closingIssuesReferences
+        issues.push(...page.nodes)
+      }
+      if (issues.length !== page.totalCount || new Set(issues.map(issue => issue.id)).size !== issues.length) throw new Error('Incomplete or duplicate closing-issue relation: ' + pull.number)
+      await migration.atomicJson(root + '/' + pull.number + '.json', { sourceNumber: pull.number, sourceUrl: pull.html_url, closingIssues: issues })
+      links += issues.length
+    }
+    console.log('Collected closing-issue relations for ' + Math.min(offset + 50, pulls.length) + '/' + pulls.length + ' source PRs')
+  }
+  await migration.atomicJson(root + '/complete.json', { completedAt: new Date().toISOString(), pullRequests: pulls.length, links })
+}
+main().catch(error => { console.error(request.safeError(error)); process.exitCode = 1 })
