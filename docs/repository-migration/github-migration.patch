diff --git a/verifyRehearsal.js b/verifyRehearsal.js
new file mode 100644
index 0000000..f477b4f
--- /dev/null
+++ b/verifyRehearsal.js
@@ -0,0 +1,100 @@
+const assert = require('node:assert/strict')
+const fs = require('fs-extra')
+const config = require('./config')
+const migration = require('./migrationState')
+const { render, objectPresentation } = require('./migrationContent')
+const { mappedTitle } = require('./updateIssues')
+const { remoteRefs } = require('./createBranches')
+const { destinationFileCoverage } = require('./historyFiles')
+
+const main = async () => {
+  assert.equal(config.target.repo, 'larch-migration-rehearsal-20260928')
+  const state = await fs.readJson('larch/rehearsal-state.json')
+  const issues = await migration.list('/issues?state=all')
+  const comments = await migration.list('/issues/comments')
+  const byNumber = new Map(issues.map(issue => [issue.number, issue]))
+  const byCommentId = new Map(comments.map(comment => [comment.id, comment]))
+  const records = Object.values(state.objects).filter(object => object.status === 'verified')
+  assert.equal(issues.length, records.length + 2)
+  assert.equal(state.objects[9076].status, 'deferred')
+  assert.equal(state.objects[9076].targetNumber, undefined)
+  assert.equal(Object.keys(state.pending).length, 0)
+  assert.equal(state.objects[1].targetNumber, 2)
+  assert.equal(state.objects[66].targetNumber, 4)
+  const seed = await fs.readFile('../reports/rehearsal-seed.md', 'utf8')
+  for (const number of [1, 3]) {
+    assert.equal(migration.normalize(byNumber.get(number).body), migration.normalize(seed))
+    assert.equal(byNumber.get(number).state, 'open')
+    assert.equal(byNumber.get(number).comments, 0)
+  }
+  const pullEvidence = []
+  const bodyLengths = {}
+  for (const object of records) {
+    const source = await fs.readJson('larch/issues/issue-' + object.sourceNumber + '.json')
+    const remote = byNumber.get(object.targetNumber)
+    assert.equal(remote.id, object.targetIssueId)
+    assert.equal(remote.html_url, object.targetUrl)
+    assert.equal(remote.title, mappedTitle(source.title, state.objects))
+    assert.equal(remote.state, source.state)
+    assert.equal(Boolean(remote.locked), Boolean(source.locked))
+    assert.deepEqual(remote.labels.map(label => label.name).sort(), source.labels.map(label => label.name).sort())
+    assert.deepEqual(remote.assignees.map(user => user.login).sort(), source.assignees.map(user => user.login).sort())
+    if (object.targetKind === 'issue') assert.equal(remote.state_reason, source.state_reason)
+    const expected = await render(source, 'object', state.objects, state.commentUrls, objectPresentation(source, state.objects, object).extra, Infinity)
+    assert.equal(migration.normalize(remote.body), migration.normalize(expected.body))
+    assert.equal(migration.sha256(migration.normalize(remote.body)), object.bodySha256)
+    bodyLengths[object.sourceNumber] = remote.body.length
+    if (object.targetKind === 'pull') {
+      const pull = await migration.call('GET', '/pulls/' + object.targetNumber)
+      assert.equal(pull.id, object.targetPullId)
+      assert.equal(pull.state, 'closed')
+      assert.equal(pull.merged, false)
+      assert.equal(pull.merged_at, null)
+      assert.equal(pull.head.sha, source.head.sha)
+      assert.equal(pull.base.sha, source.base.sha)
+      const files = await migration.list('/pulls/' + object.targetNumber + '/files')
+      assert.ok(files.length > 0)
+      const history = await fs.readJson('larch/history/pulls/' + source.number + '.json')
+      const coverage = destinationFileCoverage(history, pull, files)
+      pullEvidence.push({ sourceNumber: source.number, targetNumber: pull.number, state: pull.state, merged: pull.merged, retainedFiles: files.length, fileCoverage: coverage, baseSha: pull.base.sha, headSha: pull.head.sha })
+    }
+  }
+  const activeComments = Object.values(state.comments).filter(comment => comment.status === 'verified')
+  assert.equal(activeComments.length, 37)
+  assert.equal(comments.length, 37)
+  assert.equal(new Set(activeComments.map(comment => comment.targetId)).size, 37)
+  for (const comment of activeComments) {
+    const remote = byCommentId.get(comment.targetId)
+    assert.ok(remote.body.startsWith(comment.marker))
+    assert.equal(migration.sha256(migration.normalize(remote.body)), comment.bodySha256)
+    assert.equal(remote.html_url, comment.targetUrl)
+    assert.equal(Number(remote.issue_url.split('/').pop()), comment.targetNumber)
+    assert.notEqual(comment.sourceNumber, 9076)
+  }
+  const actions = await migration.call('GET', '/actions/permissions')
+  const runs = await migration.call('GET', '/actions/runs?per_page=1')
+  assert.equal(actions.enabled, false)
+  assert.equal(runs.total_count, 0)
+  const refs = [...remoteRefs()]
+  assert.ok(!refs.some(([ref]) => /pr9076(base|head)$/.test(ref)))
+  assert.equal(refs.find(([ref]) => ref === 'refs/heads/main')[1], '21d2c3ed5aef5fdde5c550a7d1788e8e680693dc')
+  const audit = (await fs.readFile('larch/rehearsal-state.jsonl', 'utf8')).trim().split('\n').map(line => JSON.parse(line))
+  assert.ok(audit.some(event => event.key === 'object:1' && event.action === 'reconciled-remote-success'))
+  if (state.cleanup?.completedAt) {
+    assert.equal(refs.length, 1)
+    assert.equal(state.cleanup.deletedRefs, Object.keys(state.branches).length)
+    assert.ok(Object.values(state.branches).every(branch => branch.status === 'deleted'))
+  }
+  const report = {
+    status: state.cleanup?.completedAt ? 'verified' : 'ready-for-cleanup', verifiedAt: new Date().toISOString(),
+    toolRevision: '241c203953fb516609b16f454098daa1b48d7d73', target: state.target,
+    selection: (await migration.issueFiles()).map(issue => issue.number),
+    checks: { existingPlanningIssuesPreserved: 2, mappedHistoricalObjects: records.length, preservedCommentsAndReviews: comments.length, duplicateMarkers: 0, source9076Deferred: true, actionsDisabled: true, workflowRuns: 0, restartAfterRemoteSuccessRecovered: true, unrelatedNumberConsumptionHandled: true, fullLongDescriptionsRestored: true, syntheticRefsCleaned: Boolean(state.cleanup?.completedAt) },
+    bodyLengths, pullEvidence, refs,
+    longBodyApiBehavior: { createLimit: 65536, fullBodyPatchAccepted: [2671, 7682], obsoleteRehearsalFragmentsRemoved: 2 },
+  }
+  await migration.atomicJson('../reports/rehearsal-verification.json', report)
+  if (report.status === 'verified') await migration.atomicJson('larch/rehearsal-verified.json', report)
+  console.log(JSON.stringify(report, null, 2))
+}
+main().catch(error => { console.error(require('./migrationRequest').safeError(error)); process.exitCode = 1 })
