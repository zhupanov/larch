+  }
+  const identity = '<!-- larch-repository-migration:completed-leaf:' + number + ' -->'
+  const content = number === 4
+    ? 'Verified ' + audit.objects + ' historical destination objects, including ' + audit.pullRequests + ' closed, unmerged PRs. All ' + audit.issueComments + ' issue comments, ' + audit.inlineComments + ' inline comments, and ' + audit.reviews + ' review records were checked against the source export and attributed destination copies. Three source PRs with no recreatable diff have explicit archival-issue mappings. Actual GitHub IDs and numbers are retained in the mapping.'
+    : 'Verified the complete research archive, repaired references, and native relationship replay. Every source PR has an archival record, including the deferred live PR. The audit checked ' + audit.nativeEdges + ' native relationships. Deleted exactly ' + state.cleanup.deletedRefs + ' ledger-owned synthetic refs, preserved other refs, and independently checked the destination again after cleanup.'
