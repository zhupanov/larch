+const fs = require('fs-extra')
+const config = require('./config')
+const migration = require('./migrationState')
+const { assertReplayComplete, assertReplayAudited } = require('./historyCorpus')
+const { loadCollection } = require('./historyCollection')
+
+const planRelations = (raw, mapping, selected) => {
+  const groups = [], archival = []
+  const sourceRepo = 'https://api.github.com/repos/' + config.source.org + '/' + config.source.repo
+  for (const [kind, collections, property] of [['sub-issue', raw.parents, 'children'], ['blocked-by', raw.blockedBy, 'blockers']]) {
+    for (const collection of collections) {
+      if (selected && !selected.has(collection.sourceNumber)) continue
+      const from = mapping[collection.sourceNumber]
+      const edges = []
+      for (const [position, related] of collection[property].entries()) {
+        const base = { kind, sourceNumber: collection.sourceNumber, relatedNumber: related.number, relatedUrl: related.html_url, position }
+        const to = mapping[related.number]
+        let reason
+        if (related.repository_url !== sourceRepo) reason = 'Related issue is outside the migrated repository'
+        else if (migration.isDeferred(collection.sourceNumber) || migration.isDeferred(related.number)) reason = 'Deferred to final live-PR leaf #9'
+        else if (!from || !to || from.status !== 'verified' || to.status !== 'verified') {
+          if (selected && !selected.has(related.number)) reason = 'Outside the bounded rehearsal selection'
+          else throw new Error('Missing relation mapping: ' + kind + ' ' + collection.sourceNumber + ' -> ' + related.number)
+        } else if (from.targetKind !== 'issue' || to.targetKind !== 'issue') reason = 'GitHub native issue relationships do not accept pull requests'
+        if (reason) archival.push({ ...base, reason })
+        else edges.push({ ...base, targetNumber: from.targetNumber, targetIssueId: from.targetIssueId, relatedTargetNumber: to.targetNumber, relatedTargetIssueId: to.targetIssueId })
+      }
+      if (edges.length) groups.push({ kind, sourceNumber: collection.sourceNumber, targetNumber: from.targetNumber, edges })
+    }
+  }
+  return { groups, archival }
+}
+
+const restoreGroup = async (group, state) => {
+  state.nativeRelations = state.nativeRelations || { edges: {}, archival: [] }
+  const endpoint = '/issues/' + group.targetNumber + (group.kind === 'sub-issue' ? '/sub_issues' : '/dependencies/blocked_by')
+  const expected = group.edges.map(edge => edge.relatedTargetIssueId)
+  let current = await migration.list(endpoint)
+  if (new Set(current.map(item => item.id)).size !== current.length || current.some(item => !expected.includes(item.id))) throw new Error('Unexpected native relationships on imported issue ' + group.targetNumber)
+  if (group.kind === 'sub-issue' && current.some((item, index) => item.id !== expected[index])) throw new Error('Sub-issue order changed outside the migration: ' + group.targetNumber)
+  for (const edge of group.edges) {
+    const key = group.kind + ':' + edge.sourceNumber + ':' + edge.relatedNumber
+    if (!current.some(item => item.id === edge.relatedTargetIssueId)) {
+      if (group.kind === 'sub-issue') {
+        let parent
+        try { parent = await migration.call('GET', '/issues/' + edge.relatedTargetNumber + '/parent') }
+        catch (error) { if (error.statusCode !== 404) throw error }
+        if (parent && parent.id !== edge.targetIssueId) throw new Error('Refusing to replace an existing destination parent')
+      }
+      state.nativeRelations.edges[key] = { ...edge, intentAt: new Date().toISOString() }
+      await migration.save()
+      await migration.audit({ action: 'create-native-relation-intent', key, ...edge })
+      await migration.call('POST', endpoint, group.kind === 'sub-issue' ? { sub_issue_id: edge.relatedTargetIssueId, replace_parent: false } : { issue_id: edge.relatedTargetIssueId })
+      current = await migration.list(endpoint)
+      if (!current.some(item => item.id === edge.relatedTargetIssueId)) throw new Error('Native relation not present after successful API write')
+    }
+    state.nativeRelations.edges[key] = { ...state.nativeRelations.edges[key], ...edge, status: 'verified', verifiedAt: new Date().toISOString() }
+    await migration.save()
+  }
+  if (current.length !== expected.length) throw new Error('Native relation count differs after reconciliation')
+  if (group.kind === 'sub-issue' && current.some((item, index) => item.id !== expected[index])) throw new Error('Restored sub-issue order differs')
+}
+
+const main = async () => {
+  const state = migration.state()
+  await assertReplayAudited(state)
+  const records = await assertReplayComplete(state)
+  const { relations: raw } = await loadCollection(records)
+  const plan = planRelations(raw, state.objects, new Set(records.map(record => record.number)))
+  state.nativeRelations = state.nativeRelations || { edges: {}, archival: [] }
+  state.nativeRelations.archival = plan.archival
+  await migration.save()
+  for (const [index, group] of plan.groups.entries()) {
+    await restoreGroup(group, state)
+    if ((index + 1) % 25 === 0) console.log('Verified native relationship groups: ' + (index + 1) + '/' + plan.groups.length)
+  }
+  state.nativeRelations.completedAt = new Date().toISOString()
+  await migration.save()
+  console.log('Native relationships restored: ' + Object.keys(state.nativeRelations.edges).length + '; archival exceptions: ' + plan.archival.length)
+}
+if (require.main === module) migration.run('restoreNativeRelations', main)
+module.exports = { main, planRelations, restoreGroup }
