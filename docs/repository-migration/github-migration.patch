+const { execFileSync } = require('node:child_process')
+const path = require('node:path')
+const fs = require('node:fs')
+
+const blockedStages = new Set(['increment', 'rewrite', 'bfg'])
+const entryPoint = path.basename(process.argv[1] || '').replace(/\.js$/, '')
+if (blockedStages.has(entryPoint)) {
+  throw new Error('Migration is stopped: this stage is not validated for the populated destination')
+}
+if (entryPoint === 'createReleases') {
+  if (process.env.MIGRATION_TEST_REPO === 'larch-migration-rehearsal-20260928') {
+    if (!process.env.MIGRATION_SELECTION) throw new Error('Release rehearsal requires the explicit bounded rehearsal context')
+  } else {
+    const report = 'larch/release-rehearsal-verified.json'
+    if (!fs.existsSync(report) || JSON.parse(fs.readFileSync(report, 'utf8')).status !== 'verified') throw new Error('Migration is stopped: production release import requires a verified release rehearsal')
+  }
+}
+const replayStages = new Set(['createBranches', 'createIssues', 'createComments', 'updateIssues', 'provisionMetadata', 'deleteBranches', 'repairHistoryReferences', 'restoreNativeRelations', 'buildHistoryArchive', 'auditHistorical', 'auditReplay', 'completeHistoricalLeaf', 'restoreConfiguration'])
+const supplementStages = new Set(['repairHistoryReferences', 'restoreNativeRelations', 'buildHistoryArchive', 'auditHistorical', 'restoreConfiguration'])
+if (supplementStages.has(entryPoint) && !process.env.MIGRATION_TEST_REPO) {
+  const report = 'larch/history-rehearsal-verified.json'
+  if (!fs.existsSync(report) || JSON.parse(fs.readFileSync(report, 'utf8')).status !== 'verified') throw new Error('Migration is stopped: production history completion requires its verified rehearsal')
+}
+if (replayStages.has(entryPoint)) {
+  if (process.env.MIGRATION_TEST_REPO === 'larch-migration-rehearsal-20260928') {
+    if (!process.env.MIGRATION_SELECTION) throw new Error('Migration is stopped: rehearsal requires an explicit source selection')
+  } else {
+    const report = 'larch/rehearsal-verified.json'
+    if (!fs.existsSync(report) || JSON.parse(fs.readFileSync(report, 'utf8')).status !== 'verified') {
+      throw new Error('Migration is stopped: production replay requires a verified rehearsal')
+    }
+  }
+}
+
+const ghToken = () => {
+  try {
+    return execFileSync('gh', ['auth', 'token', '--hostname', 'github.com'], {
+      encoding: 'utf8',
+      stdio: ['ignore', 'pipe', 'pipe'],
+    }).trim()
+  } catch (_) {
+    throw new Error('Cannot obtain the authenticated GitHub credential')
+  }
+}
+
+const targetRepo = process.env.MIGRATION_TEST_REPO || 'larch'
+if (!['larch', 'larch-migration-rehearsal-20260928'].includes(targetRepo)) {
+  throw new Error('Target repository is not on the migration allowlist')
+}
+
+module.exports = {
+  source: {
+    baseUrl: 'https://api.github.com/repos',
+    org: 'character-ai',
+    repo: 'larch',
+    token: process.env.MIGRATION_SOURCE_TOKEN || ghToken(),
+  },
+  target: {
+    baseUrl: 'https://api.github.com/repos',
+    org: 'zhupanov',
+    repo: targetRepo,
+    token: process.env.MIGRATION_TARGET_TOKEN || ghToken(),
+    avatarUrl: '',
+  },
+  apiCallsPerHour: 400,
+  gitMirror: 'replay.git',
+  s3Bucket: '',
+  bfg: '',
+  excludedPullRequests: [9076],
+  enableWrites: process.env.MIGRATION_WRITE === '1',
+}
