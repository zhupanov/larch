+      const matches = (await migration.list('/rulesets?includes_parents=true')).filter(value => value.name === desired.name)
+      if (matches.length > 1) throw new Error('Duplicate destination ruleset name: ' + desired.name)
+      existing = matches[0]
+      if (existing && existing.source_type !== 'Repository') throw new Error('Refusing to alter an inherited ruleset')
+      return existing ? rulesetPolicy(await get('/rulesets/' + existing.id)) : null
+    }
+    const previous = plan.targetSnapshot.rulesets.find(value => value.name === desired.name)
+    const key = 'ruleset:' + desired.name
+    // Read by unique name after any lost POST response before considering a retry.
+    if (ledger[key]?.intentAt && !ledger[key]?.verifiedAt) {
+      const remaining = Date.parse(ledger[key].intentAt) + 90000 - Date.now()
+      if (remaining > 0) await new Promise(resolve => setTimeout(resolve, remaining))
+    }
+    await applySetting(key, desired, previous ? rulesetPolicy(previous) : null, read,
+      () => existing ? migration.call('PUT', '/rulesets/' + existing.id, desired) : migration.call('POST', '/rulesets', desired))
+  }
+  const chief = state.objects[7687]
+  if (!chief || chief.targetKind !== 'issue' || !chief.metadataVerifiedAt) throw new Error('The imported Chief mapping is not verified')
+  const chiefValue = String(chief.targetNumber)
+  await applySetting('chiefVariable', chiefValue, null,
+    async () => { const current = await optional(() => get('/actions/variables/LARCH_MIGRATION_CHIEF')); return current.present ? current.value.value : null },
+    () => migration.call('POST', '/actions/variables', { name: 'LARCH_MIGRATION_CHIEF', value: chiefValue }))
+  const { main: provisionMetadata } = require('./provisionMetadata')
+  await provisionMetadata()
+  await assertPrerequisites(state)
+  const actions = await get('/actions/permissions')
+  if (actions.enabled && !ledger.actions?.intentAt && !ledger.actions?.verifiedAt) throw new Error('Actions was enabled outside the guarded configuration replay')
+  if (!actions.enabled) {
+    const runs = await get('/actions/runs?per_page=1')
+    if (runs.total_count !== 0) throw new Error('Historical migration unexpectedly generated Actions runs')
+    state.configuration.noHistoricalRunsVerifiedAt = new Date().toISOString()
+    await migration.save()
+  }
+  // This is deliberately the last configuration mutation.
+  await applySetting('actions', plan.desired.actions, pick(plan.targetSnapshot.actions, ['enabled', 'allowed_actions', 'sha_pinning_required']),
+    async () => pick(await get('/actions/permissions'), ['enabled', 'allowed_actions', 'sha_pinning_required']),
+    () => migration.call('PUT', '/actions/permissions', plan.desired.actions))
+  state.configuration.appliedAt = new Date().toISOString()
+  state.configuration.ciValidation = 'pending-separate-pr'
+  state.configuration.governanceWorkflow = 'enable-only-after-canonical-code-merge'
+  await migration.save()
