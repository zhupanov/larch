diff --git a/previewReplay.js b/previewReplay.js
new file mode 100644
index 0000000..e5b2624
--- /dev/null
+++ b/previewReplay.js
@@ -0,0 +1,62 @@
+const fs = require('fs-extra')
+const config = require('./config')
+const migration = require('./migrationState')
+const { render, limit } = require('./migrationContent')
+
+const main = async () => {
+  if (config.enableWrites || process.env.MIGRATION_SELECTION || config.target.repo !== 'larch') throw new Error('The full preview requires read-only production configuration')
+  const issues = await migration.issueFiles()
+  const numbers = new Set(issues.map(issue => issue.number))
+  if (numbers.size !== issues.length) throw new Error('Duplicate source numbers')
+  const records = []
+  const largeBodies = []
+  let processed = 0
+  for (const issue of issues) {
+    if (migration.isDeferred(issue.number)) { records.push({ sourceNumber: issue.number, operation: 'defer', leaf: 9 }); continue }
+    const body = await render(issue, 'object')
+    if (body.parts.length) largeBodies.push({ number: issue.number, sourceLength: (issue.body || '').length, restoration: 'PATCH full description after short POST' })
+    records.push({ sourceNumber: issue.number, sourceId: issue.id, sourceKind: issue.pull_request ? 'pull' : 'issue', operation: 'create-and-restore-state', sourceState: issue.state, bodySha256: migration.sha256(body.body), creationLength: body.body.length, requiresFullBodyPatch: Boolean(body.parts.length) })
+    processed++
+    if (processed % 1000 === 0) console.log('Previewed ' + processed + ' source issues and PRs')
+  }
+  const commentCounts = {}
+  const largeComments = []
+  const seen = new Set()
+  for (const [file, kind] of [['issue-comments', 'issue-comment'], ['pull-comments', 'pull-comment'], ['reviews', 'review']]) {
+    const comments = await fs.readJson(config.source.repo + '/' + file + '.json')
+    const count = { raw: comments.length, replay: 0, deferred: 0, privateArchive: 0, continuationWrites: 0 }
+    for (const comment of comments) {
+      const number = Number(String(comment.issue_url || comment.pull_request_url || '').split('/').pop())
+      if (!numbers.has(number)) throw new Error('Comment parent missing from source export: ' + comment.id)
+      const key = kind + ':' + comment.id
+      if (seen.has(key)) throw new Error('Duplicate comment identity: ' + key)
+      seen.add(key)
+      if (migration.isDeferred(number)) { count.deferred++; continue }
+      if (kind === 'review' && comment.state === 'PENDING') { count.privateArchive++; continue }
+      const body = await render(comment, kind)
+      if (body.parts.length) largeComments.push({ sourceNumber: number, id: comment.id, kind, sourceLength: (comment.body || '').length, parts: body.parts.length })
+      count.replay++
+      count.continuationWrites += body.parts.length
+    }
+    commentCounts[kind] = count
+    console.log('Previewed ' + comments.length + ' ' + kind + ' records')
+  }
+  const gaps = Array.from({ length: Math.max(...numbers) }, (_, index) => index + 1).filter(number => !numbers.has(number))
+  const report = {
+    createdAt: new Date().toISOString(), source: 'character-ai/larch', target: 'zhupanov/larch', sourceObjects: issues.length,
+    historicalIssues: issues.filter(issue => !issue.pull_request).length,
+    historicalPulls: issues.filter(issue => issue.pull_request && !migration.isDeferred(issue.number)).length,
+    deferredSourceNumbers: issues.filter(issue => migration.isDeferred(issue.number)).map(issue => issue.number),
+    sourceNumberGaps: gaps, largeBodies, largeComments, commentCounts,
+    creationLimit: limit, sourceReferencesQualifiedBeforeMapping: true,
+    destinationNumbers: 'Use returned IDs and numbers only; preview makes no numbering assumptions',
+    approximateContentWrites: processed * 2 + largeBodies.length + Object.values(commentCounts).reduce((sum, value) => sum + value.replay + value.continuationWrites, 0),
+    contentWritesPerHour: config.apiCallsPerHour,
+    unsupportedNativeFidelity: ['Original author and timestamps', 'Merged PR status without merging code', 'Original reviewer identities and approvals', 'Historical event identities and timestamps', 'Source repository-scoped build attestations'],
+    reactions: issues.reduce((sum, issue) => sum + (issue.reactions?.total_count || 0), 0),
+    records,
+  }
+  await migration.atomicJson('../reports/production-mutation-preview.json', report)
+  console.log(JSON.stringify({ ...report, records: report.records.length }, null, 2))
+}
+main().catch(error => { console.error(require('./migrationRequest').safeError(error)); process.exitCode = 1 })
diff --git a/probeNativeRelations.js b/probeNativeRelations.js
new file mode 100644
index 0000000..cfd4aaf
--- /dev/null
+++ b/probeNativeRelations.js
@@ -0,0 +1,57 @@
+const fs = require('fs-extra')
+const config = require('./config')
+const migration = require('./migrationState')
+
+// A bounded rehearsal verifies that closed historical issues can retain native
+// relationships without changing their state. Only edges created here are removed.
+const main = async () => {
+  if (config.target.repo !== 'larch-migration-rehearsal-20260928') throw new Error('This probe is restricted to the private rehearsal')
+  const file = '../reports/rehearsal-native-relations.json'
+  const evidence = await fs.pathExists(file) ? await fs.readJson(file) : { startedAt: new Date().toISOString(), target: config.target.org + '/' + config.target.repo, probes: {} }
+  const parent = await migration.call('GET', '/issues/4')
+  const child = await migration.call('GET', '/issues/6')
+  if (parent.id !== 5610036146 || child.id !== 5610038439 || parent.state !== 'closed' || child.state !== 'closed') throw new Error('Rehearsal issue identities or closed states changed')
+  const definitions = [
+    { name: 'blocked-by', list: '/issues/4/dependencies/blocked_by', add: '/issues/4/dependencies/blocked_by', body: { issue_id: child.id }, remove: '/issues/4/dependencies/blocked_by/' + child.id },
+    { name: 'sub-issue', list: '/issues/4/sub_issues', add: '/issues/4/sub_issues', body: { sub_issue_id: child.id, replace_parent: false }, remove: '/issues/4/sub_issue', removeBody: { sub_issue_id: child.id } },
+  ]
+  for (const probe of definitions) {
+    if (evidence.probes[probe.name]?.removedAt) continue
+    let current = await migration.list(probe.list)
+    if (!evidence.probes[probe.name]) {
+      if (current.length) throw new Error('Unexpected existing rehearsal relationships')
+      if (probe.name === 'sub-issue') {
+        try { await migration.call('GET', '/issues/6/parent'); throw new Error('Rehearsal child already has a parent') }
+        catch (error) { if (error.statusCode !== 404) throw error }
+      }
+      evidence.probes[probe.name] = { intentAt: new Date().toISOString(), parent: parent.id, child: child.id, initiallyEmpty: true }
+      await migration.atomicJson(file, evidence)
+    }
+    const record = evidence.probes[probe.name]
+    if (!current.some(item => item.id === child.id)) {
+      if (record.removalIntentAt) {
+        record.removedAt = new Date().toISOString()
+        await migration.atomicJson(file, evidence)
+        continue
+      }
+      await migration.call('POST', probe.add, probe.body)
+      current = await migration.list(probe.list)
+    }
+    if (current.length !== 1 || current[0].id !== child.id) throw new Error('Native relationship read-back differs')
+    if (probe.name === 'sub-issue' && (await migration.call('GET', '/issues/6/parent')).id !== parent.id) throw new Error('Child parent read-back differs')
+    for (const number of [4, 6]) if ((await migration.call('GET', '/issues/' + number)).state !== 'closed') throw new Error('Native relationship changed issue state')
+    record.verifiedAt = new Date().toISOString()
+    record.removalIntentAt = new Date().toISOString()
+    await migration.atomicJson(file, evidence)
+    await migration.call('DELETE', probe.remove, probe.removeBody)
+    if ((await migration.list(probe.list)).length) throw new Error('Owned rehearsal relationship was not removed')
+    record.removedAt = new Date().toISOString()
+    await migration.atomicJson(file, evidence)
+  }
+  if ((await migration.call('GET', '/actions/runs?per_page=1')).total_count !== 0) throw new Error('Unexpected rehearsal CI run')
+  evidence.completedAt = new Date().toISOString()
+  evidence.closedIssuesSupported = true
+  await migration.atomicJson(file, evidence)
+  console.log('Closed sub-issues and dependencies verified; owned test edges removed; CI runs remain zero')
+}
+if (require.main === module) migration.run('probeNativeRelations', main)
diff --git a/provisionMetadata.js b/provisionMetadata.js
new file mode 100644
index 0000000..9991722
--- /dev/null
+++ b/provisionMetadata.js
@@ -0,0 +1,52 @@
+const fs = require('fs-extra')
+const migration = require('./migrationState')
+const config = require('./config')
+
+const main = async () => {
+  const state = migration.state()
+  const sourceLabels = await fs.readJson('../baseline/source/labels.json')
+  const sourceMilestones = await fs.readJson('../baseline/source/milestones.json')
+  const labels = new Map((await migration.list('/labels')).map(label => [label.name.toLowerCase(), label]))
+  for (const label of sourceLabels) {
+    const body = { name: label.name, color: label.color, description: label.description || '' }
+    let target = labels.get(label.name.toLowerCase())
+    if (!target) {
+      target = await migration.call('POST', '/labels', body)
+    } else if (target.color.toLowerCase() !== label.color.toLowerCase() || (target.description || '') !== body.description || target.name !== body.name) {
+      target = await migration.call('PATCH', '/labels/' + encodeURIComponent(target.name), { new_name: body.name, color: body.color, description: body.description })
+    }
+    const readback = await migration.call('GET', '/labels/' + encodeURIComponent(label.name))
+    if (readback.name !== body.name || readback.color.toLowerCase() !== body.color.toLowerCase() || (readback.description || '') !== body.description) throw new Error('Label verification failed: ' + label.name)
+    state.labels[label.name] = { sourceId: label.id, targetId: readback.id, name: readback.name, status: 'verified' }
+    await migration.save()
+  }
+  const milestones = await migration.list('/milestones?state=all')
+  for (const milestone of sourceMilestones) {
+    const matches = milestones.filter(item => item.title === milestone.title)
+    if (matches.length > 1) throw new Error('Ambiguous destination milestone title: ' + milestone.title)
+    let target = matches[0]
+    const body = { title: milestone.title, state: milestone.state, description: milestone.description || '', due_on: milestone.due_on }
+    if (!target) target = await migration.call('POST', '/milestones', body)
+    else if (target.state !== body.state || (target.description || '') !== body.description || target.due_on !== body.due_on) target = await migration.call('PATCH', '/milestones/' + target.number, body)
+    const readback = await migration.call('GET', '/milestones/' + target.number)
+    if (readback.title !== body.title || readback.state !== body.state || (readback.description || '') !== body.description || readback.due_on !== body.due_on) throw new Error('Milestone verification failed: ' + milestone.number)
+    state.milestones[milestone.number] = { sourceId: milestone.id, targetId: readback.id, targetNumber: readback.number, status: 'verified' }
+    await migration.save()
+  }
+  const users = [...new Set((await migration.issueFiles()).flatMap(issue => (issue.assignees || []).map(user => user.login)))]
+  state.assignees = state.assignees || {}
+  for (const login of users) {
+    try {
+      await migration.call('GET', '/assignees/' + encodeURIComponent(login))
+      state.assignees[login] = { status: 'assignable' }
+    } catch (error) {
+      if (error.statusCode !== 404) throw error
+      state.assignees[login] = { status: 'archival-only', reason: 'Source assignee cannot be assigned in destination' }
+    }
+  }
+  state.metadataProvisionedAt = new Date().toISOString()
+  await migration.save()
+  console.log('Verified ' + sourceLabels.length + ' labels, ' + sourceMilestones.length + ' milestones, and ' + users.length + ' assignee dispositions')
+}
+if (require.main === module) migration.run('provisionMetadata', main)
+module.exports = { main }
diff --git a/releaseAssets.js b/releaseAssets.js
new file mode 100644
index 0000000..7697e09
--- /dev/null
+++ b/releaseAssets.js
@@ -0,0 +1,69 @@
+const fs = require('fs-extra')
+const path = require('node:path')
+const { execFileSync } = require('node:child_process')
+const migration = require('./migrationState')
+
+const expectedNames = tag => {
+  if (!/^v\d+\.\d+\.\d+$/.test(tag)) throw new Error('Baseline tag must be a stable version')
+  return ['larch-' + tag + '-aarch64-apple-darwin.tar.gz', 'larch-' + tag + '-manifest.json', 'larch-' + tag + '-SHA256SUMS']
+}
+const assertAssets = (release, expected) => {
+  const names = release.assets.map(asset => asset.name).sort()
+  if (JSON.stringify(names) !== JSON.stringify(expectedNames(release.tag_name).sort())) throw new Error('Release assets differ from the exact three-file allowlist')
+  for (const asset of release.assets) {
+    if (asset.state !== 'uploaded' || !/^sha256:[a-f0-9]{64}$/.test(asset.digest || '') || !Number.isSafeInteger(asset.size) || asset.size <= 0) throw new Error('Release asset is incomplete: ' + asset.name)
+    if (expected) {
+      const original = expected.find(item => item.name === asset.name)
+      if (!original || original.digest !== asset.digest || original.size !== asset.size) throw new Error('Copied asset metadata differs from upstream: ' + asset.name)
+    }
+  }
+}
+const verifyFile = async (file, asset) => {
+  const stat = await fs.lstat(file)
+  if (!stat.isFile() || stat.isSymbolicLink() || stat.size !== asset.size || 'sha256:' + migration.sha256(await fs.readFile(file)) !== asset.digest) throw new Error('Release asset content differs: ' + asset.name)
+}
+const verifyLocalSet = async (directory, source, commit) => {
+  assertAssets(source)
+  for (const asset of source.assets) await verifyFile(path.join(directory, asset.name), asset)
+  const tag = source.tag_name
+  const archiveName = 'larch-' + tag + '-aarch64-apple-darwin.tar.gz'
+  const archive = source.assets.find(asset => asset.name === archiveName)
+  const manifestName = 'larch-' + tag + '-manifest.json'
+  const manifestAsset = source.assets.find(asset => asset.name === manifestName)
+  const manifest = await fs.readJson(path.join(directory, manifestName))
+  if (manifest.schema_version !== 1 || manifest.plugin_version !== tag.slice(1) || manifest.tag !== tag || manifest.source_commit !== commit || manifest.assets.length !== 1) throw new Error('Baseline manifest identity differs')
+  const item = manifest.assets[0]
+  if (item.target !== 'aarch64-apple-darwin' || item.archive !== archiveName || item.byte_size !== archive.size || item.sha256 !== archive.digest.slice(7) || item.binary_path !== 'larch' || item.minimum_os_or_libc?.kind !== 'macos' || item.minimum_os_or_libc?.version !== '11.0') throw new Error('Baseline manifest asset contract differs')
+  const checksumText = await fs.readFile(path.join(directory, 'larch-' + tag + '-SHA256SUMS'), 'utf8')
+  const lines = checksumText.trim().split('\n')
+  const expected = [archive, manifestAsset].map(asset => asset.digest.slice(7) + '  ' + asset.name).sort()
+  if (JSON.stringify(lines.sort()) !== JSON.stringify(expected)) throw new Error('Baseline checksum file differs from verified assets')
+}
+const gh = (args, outputFile) => {
+  const environment = { ...process.env, GH_PROMPT_DISABLED: '1', GIT_TRACE: '0', GIT_TRACE_CURL: '0', GIT_CURL_VERBOSE: '0' }
+  delete environment.GH_DEBUG
+  try {
+    const result = execFileSync('gh', args, { env: environment, encoding: 'utf8', stdio: ['ignore', 'pipe', 'pipe'], maxBuffer: 16 * 1024 * 1024 })
+    if (outputFile) fs.writeFileSync(outputFile, result, { mode: 0o600 })
+    return result
+  } catch (error) {
+    throw new Error('GitHub CLI failed for ' + args.slice(0, 3).join(' ') + '; reconcile the recorded release or asset intent before retrying: ' + String(error.stderr || '').slice(0, 1000))
+  }
+}
+const downloadVerified = async (repo, tag, asset, directory) => {
+  await fs.ensureDir(directory)
+  const file = path.join(directory, asset.name)
+  if (!await fs.pathExists(file)) {
+    const temporary = file + '.download'
+    if (await fs.pathExists(temporary)) {
+      await verifyFile(temporary, asset)
+    } else {
+      gh(['release', 'download', tag, '--repo', repo, '--pattern', asset.name, '--output', temporary])
+      await verifyFile(temporary, asset)
+    }
+    await fs.rename(temporary, file)
+  }
+  await verifyFile(file, asset)
+  return file
+}
+module.exports = { expectedNames, assertAssets, verifyFile, verifyLocalSet, downloadVerified, gh }
