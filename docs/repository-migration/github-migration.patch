+  const backup = await fs.readJson('../reports/' + (number === 4 ? 'replay' : 'history') + '-backup.json')
+  if (backup.status !== 'verified' || backup.target !== state.target || !backup.readBackVerified || backup.auditVerifiedAt !== audit.verifiedAt) throw new Error('A verified private backup of this exact audit is required')
+  if (number === 5) {
+    const prerequisite = await migration.call('GET', '/issues/4')
+    if (prerequisite.state !== 'closed' || prerequisite.state_reason !== 'completed') throw new Error('Historical leaf 4 must finish first')
+    if (!state.cleanup?.completedAt || audit.verifiedAt < state.cleanup.completedAt || backup.archiveManifestSha256 !== state.archive.manifestSha256) throw new Error('Leaf 5 requires a backed-up audit after synthetic-ref cleanup')
+  }
+  const original = (await fs.readJson('../baseline/target/issues-before-import.json')).find(issue => issue.number === number)
+  let remote = await migration.call('GET', '/issues/' + number)
+  state.planningIssueCompletions = state.planningIssueCompletions || {}
+  let completion = state.planningIssueCompletions[number]
+  assertOwnedPlanningIssue(remote, original, completion)
+  if (completion?.verifiedAt) {
+    if (remote.state !== 'closed') throw new Error('A completed planning issue was reopened; do not close it automatically')
+    console.log('Previously completed historical leaf #' + number + ' remains verified')
