index 0000000..3c2b409
--- /dev/null
+++ b/auditHistorical.js
@@ -0,0 +1,138 @@
+const fs = require('fs-extra')
+const config = require('./config')
+const migration = require('./migrationState')
+const { render, continuation, objectPresentation } = require('./migrationContent')
+const { mappedTitle } = require('./updateIssues')
+const { discussion, inlineContext, assertReplayComplete, assertReplayAudited } = require('./historyCorpus')
+const { planRelations } = require('./restoreNativeRelations')
+const { loadCollection } = require('./historyCollection')
+const { destinationFileCoverage } = require('./historyFiles')
+
+const equalSet = (left, right) => JSON.stringify([...left].sort()) === JSON.stringify([...right].sort())
+const markerIndex = records => {
+  const result = new Map()
+  for (const record of records) {
+    const first = String(record.body || '').split('\n')[0]
+    if (!first.startsWith('<!-- github-migration:' + config.source.org + '/' + config.source.repo + ':')) continue
+    if (result.has(first)) throw new Error('Duplicate destination migration marker: ' + first)
+    result.set(first, record)
+  }
+  return result
+}
+const main = async ({ replayOnly = false } = {}) => {
+  const state = migration.state()
+  const sources = await assertReplayComplete(state)
+  if (!replayOnly) {
+    await assertReplayAudited(state)
+    if (!state.archive?.builtAt || !state.referenceRepair?.completedAt || !state.nativeRelations?.completedAt) throw new Error('Archive and relationship stages must finish before the historical audit')
+  }
+  const report = { startedAt: new Date().toISOString(), source: state.source, target: state.target, objects: 0, pullRequests: 0, issueComments: 0, inlineComments: 0, reviews: 0, deferredDiscussion: 0, archivalPullFallbacks: [], fileCoverageExceptions: [], titleExceptions: [], nativeEdges: 0, planningIssuesPreserved: 0, actionsEnabled: false, workflowRuns: null }
+  const objects = await migration.list('/issues?state=all&sort=created&direction=asc')
+  const comments = await migration.list('/issues/comments?sort=created&direction=asc')
+  const objectMarkers = markerIndex(objects), commentMarkers = markerIndex(comments)
+  const byNumber = new Map(objects.map(record => [record.number, record]))
+  const auditRoot = config.source.repo + (config.target.repo === 'larch' ? '/' : '/rehearsal-') + (replayOnly ? 'replay-audit' : 'audit')
+  await fs.ensureDir(auditRoot)
+  await migration.atomicJson(auditRoot + '/remote-objects.json', objects)
+  await migration.atomicJson(auditRoot + '/remote-comments.json', comments)
+  if (config.target.repo === 'larch') {
+    const original = await fs.readJson('../baseline/target/issues-before-import.json')
+    for (const saved of original) {
+      const now = byNumber.get(saved.number)
+      const completed = state.planningIssueCompletions?.[saved.number]?.verifiedAt
+      const expectedState = completed ? 'closed' : saved.state
+      if (!now || now.id !== saved.id || now.title !== saved.title || migration.normalize(now.body) !== migration.normalize(saved.body) || now.state !== expectedState || (completed && now.state_reason !== 'completed')) throw new Error('A preserved planning issue changed: ' + saved.number)
+      report.planningIssuesPreserved++
+    }
+  }
+  for (const source of sources) {
+    if (migration.isDeferred(source.number)) {
+      if (objectMarkers.has(migration.marker('object', source.id))) throw new Error('Deferred PR has an unexpected destination object')
+      continue
+    }
+    const mapped = state.objects[source.number]
+    const current = objectMarkers.get(mapped.marker)
+    if (!current || current.id !== mapped.targetIssueId || current.number !== mapped.targetNumber || Boolean(current.pull_request) !== (mapped.targetKind === 'pull')) throw new Error('Destination object identity differs: ' + source.number)
+    const presentation = objectPresentation(source, state.objects, mapped)
+    const expected = await render(source, 'object', state.objects, state.commentUrls, presentation.extra, Infinity)
+    migration.verifyBody(current, expected.body)
+    if (presentation.titleException) report.titleExceptions.push({ sourceNumber: source.number, targetNumber: mapped.targetNumber, ...presentation.titleException })
+    const labels = (source.labels || []).map(label => typeof label === 'string' ? label : label.name)
+    const assignees = (source.assignees || []).map(user => user.login).filter(login => state.assignees[login]?.status === 'assignable')
+    if (current.title !== mappedTitle(source.title, state.objects) || current.state !== source.state || Boolean(current.locked) !== Boolean(source.locked) || !equalSet(current.labels.map(label => label.name), labels) || !equalSet(current.assignees.map(user => user.login), assignees) || (current.milestone?.number || null) !== (source.milestone ? state.milestones[source.milestone.number].targetNumber : null)) throw new Error('Destination object metadata differs: ' + source.number)
+    if (mapped.targetKind === 'issue' && source.state_reason && current.state_reason !== source.state_reason) throw new Error('Destination close reason differs: ' + source.number)
+    if (mapped.targetKind === 'pull') {
+      const pull = await migration.call('GET', '/pulls/' + mapped.targetNumber)
+      if (pull.state !== 'closed' || pull.merged || pull.merged_at || pull.base.sha !== source.base.sha || pull.head.sha !== source.head.sha) throw new Error('Historical PR state or commits differ: ' + source.number)
+      const sourceHistory = await fs.readJson(config.source.repo + '/history/pulls/' + source.number + '.json')
+      const files = sourceHistory.gitFileHistory ? await migration.list('/pulls/' + mapped.targetNumber + '/files') : undefined
+      const coverage = destinationFileCoverage(sourceHistory, pull, files)
+      if (files) {
+        report.fileCoverageExceptions.push({ sourceNumber: source.number, targetNumber: mapped.targetNumber, ...coverage })
+        await migration.atomicJson(auditRoot + '/pull-files/' + source.number + '.json', files)
+      }
+      await migration.atomicJson(auditRoot + '/pulls/' + source.number + '.json', pull)
+      report.pullRequests++
+    } else if (mapped.archivalException) report.archivalPullFallbacks.push({ sourceNumber: source.number, targetNumber: mapped.targetNumber, reason: mapped.archivalException })
+    if (!replayOnly) {
+      const archived = await fs.readJson(state.archive.path + '/' + (source.pull_request ? 'pulls/' : 'issues/') + source.number + '.json')
+      if (archived.sourceUrl !== source.html_url || archived.destination.url !== mapped.targetUrl) throw new Error('Archive destination mapping differs: ' + source.number)
+    }
+    report.objects++
+    if (report.objects % 100 === 0) console.log('Independently audited ' + report.objects + ' historical objects')
+  }
+  for (const item of await discussion(new Set(sources.map(source => source.number)))) {
+    if (migration.isDeferred(item.number) || (item.kind === 'review' && item.record.state === 'PENDING')) { report.deferredDiscussion++; continue }
+    const commentUrls = replayOnly && !state.comments[item.key]?.referencesVerifiedAt ? {} : state.commentUrls
+    const extra = item.kind === 'pull-comment' ? inlineContext(item.record, item.number, commentUrls) : ''
+    const expected = await render(item.record, item.kind, state.objects, commentUrls, extra)
+    const parts = [{ key: item.key, body: expected.body, identity: expected.identity }]
+    for (const [index, text] of expected.parts.entries()) parts.push({ key: item.key + ':part-' + (index + 1), ...continuation(item.record, item.kind, text, index, expected.parts.length) })
+    for (const part of parts) {
+      const mapped = state.comments[part.key], current = commentMarkers.get(part.identity)
+      if (!mapped || !current || current.id !== mapped.targetId || Number(current.issue_url.split('/').pop()) !== mapped.targetNumber) throw new Error('Discussion identity or parent differs: ' + part.key)
+      migration.verifyBody(current, part.body)
+    }
+    report[item.kind === 'issue-comment' ? 'issueComments' : item.kind === 'pull-comment' ? 'inlineComments' : 'reviews']++
+  }
+  if (objectMarkers.size !== report.objects) throw new Error('Unmapped migration object markers remain in the destination')
+  const expectedComments = Object.values(state.comments).filter(comment => comment.status === 'verified').length
+  if (commentMarkers.size !== expectedComments) throw new Error('Unmapped or missing migration comment markers remain in the destination')
+  if (!replayOnly) {
+    const { relations } = await loadCollection(sources)
+    const relationPlan = planRelations(relations, state.objects, new Set(sources.map(source => source.number)))
+    for (const group of relationPlan.groups) {
+      const current = await migration.list('/issues/' + group.targetNumber + (group.kind === 'sub-issue' ? '/sub_issues' : '/dependencies/blocked_by'))
+      const expected = group.edges.map(edge => edge.relatedTargetIssueId)
+      const actual = current.map(item => item.id)
+      if (!equalSet(actual, expected) || (group.kind === 'sub-issue' && JSON.stringify(actual) !== JSON.stringify(expected))) throw new Error('Native relationship audit differs: ' + group.sourceNumber)
+      report.nativeEdges += actual.length
+    }
+  }
+  const remoteLabels = await migration.list('/labels')
+  for (const source of await fs.readJson('../baseline/source/labels.json')) {
+    const remote = remoteLabels.find(label => label.name === source.name)
+    if (!remote || remote.color !== source.color || (remote.description || '') !== (source.description || '')) throw new Error('Migrated label differs: ' + source.name)
+  }
+  if ((await migration.call('GET', '/actions/permissions')).enabled) throw new Error('CI was enabled before history cleanup')
+  report.workflowRuns = (await migration.call('GET', '/actions/runs?per_page=1')).total_count
+  if (report.workflowRuns !== 0) throw new Error('Historical replay unexpectedly triggered CI')
+  if (!replayOnly) {
+    const manifest = await fs.readFile(state.archive.path + '/SHA256SUMS', 'utf8')
+    if (migration.sha256(manifest) !== state.archive.manifestSha256) throw new Error('Archive checksum manifest changed')
+    for (const line of manifest.trim().split('\n')) {
+      const match = line.match(/^([a-f0-9]{64})  (.+)$/)
+      if (!match || match[2].startsWith('/') || match[2].split('/').includes('..')) throw new Error('Invalid archive checksum record')
+      if (migration.sha256(await fs.readFile(state.archive.path + '/' + match[2])) !== match[1]) throw new Error('Archive file checksum mismatch: ' + match[2])
+    }
+    report.archiveManifestSha256 = state.archive.manifestSha256
+  }
+  report.verifiedAt = new Date().toISOString()
+  report.leaf = replayOnly ? 4 : 5
+  await migration.atomicJson(auditRoot + '/verified.json', report)
+  state[replayOnly ? 'replayAudit' : 'historyAudit'] = report
+  await migration.save()
+  console.log(JSON.stringify(report))
+}
+if (require.main === module) migration.run('auditHistorical', main)
+module.exports = { main, markerIndex }
