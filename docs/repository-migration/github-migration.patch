@@ -0,0 +1,50 @@
+const parseGitFiles = text => {
+  const fields = text.split('\0')
+  if (fields.pop() !== '') throw new Error('Git file history is not NUL terminated')
+  const records = []
+  while (fields.length) {
+    const code = fields.shift(), first = fields.shift()
+    if (!/^(?:[ADMT]|[RC]\d{1,3})$/.test(code || '') || !first) throw new Error('Invalid retained Git name/status record')
+    const renamed = /^[RC]/.test(code)
+    const filename = renamed ? fields.shift() : first
+    if (!filename) throw new Error('Missing retained Git rename destination')
+    records.push({ code: code[0], filename, ...(renamed ? { previous_filename: first } : {}) })
+  }
+  if (new Set(records.map(record => record.filename)).size !== records.length) throw new Error('Duplicate paths in retained Git history')
+  return records
+}
+
+const allowedStatuses = { A: ['added'], D: ['removed'], M: ['modified'], T: ['changed', 'modified', 'removed', 'added'], R: ['renamed'], C: ['copied'] }
+const fileCoverage = ({ reportedFiles, files, gitFileHistory }) => {
+  if (!Number.isInteger(reportedFiles) || reportedFiles < 0 || !Array.isArray(files)) throw new Error('Invalid changed-file coverage input')
+  const uniqueFiles = new Set(files.map(file => file.filename)).size
+  const result = { providerReportedFiles: reportedFiles, apiFileEntries: files.length, uniqueFiles, completeFiles: uniqueFiles, gitFileEntries: 0, providerCounterException: false }
+  if (!gitFileHistory) {
+    if (reportedFiles !== uniqueFiles) throw new Error('Incomplete retained changed-file history')
+    return result
+  }
+  const records = parseGitFiles(gitFileHistory)
+  if (files.length !== 3000 || records.length < uniqueFiles) throw new Error('Git fallback requires the capped API file list and complete retained paths')
+  if (reportedFiles !== 0 && reportedFiles !== records.length) throw new Error('Git history disagrees with the positive provider file count')
+  const byPath = new Map(records.map(record => [record.filename, record]))
+  for (const file of files) {
+    const record = byPath.get(file.filename)
+    if (!record || !allowedStatuses[record.code].includes(file.status) || (record.previous_filename && file.previous_filename !== record.previous_filename)) throw new Error('API file entry disagrees with retained Git history: ' + file.filename)
+  }
+  return { ...result, completeFiles: records.length, gitFileEntries: records.length, providerCounterException: reportedFiles !== records.length }
+}
+
+const fileIdentity = files => files.map(file => JSON.stringify([file.filename, file.status, file.sha, file.previous_filename || null, file.additions, file.deletions, file.changes])).sort()
+const destinationFileCoverage = (source, pull, files) => {
+  const coverage = fileCoverage({ reportedFiles: source.pull.changed_files, files: source.files, gitFileHistory: source.gitFileHistory })
+  if (!source.gitFileHistory) {
+    if (pull.changed_files <= 0 || pull.changed_files !== coverage.completeFiles) throw new Error('Historical PR changed-file coverage differs')
+    return coverage
+  }
+  if (!files) throw new Error('Capped historical PR audit requires a destination file-list read-back')
+  const actual = fileCoverage({ reportedFiles: pull.changed_files, files, gitFileHistory: source.gitFileHistory })
+  if (JSON.stringify(fileIdentity(files)) !== JSON.stringify(fileIdentity(source.files))) throw new Error('Destination capped file list differs from the source')
+  return { ...coverage, destinationReportedFiles: pull.changed_files, destinationProviderCounterException: actual.providerCounterException }
+}
+
+module.exports = { parseGitFiles, fileCoverage, destinationFileCoverage }
