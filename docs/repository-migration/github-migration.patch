+process.env.MIGRATION_SOURCE_TOKEN = 'migration-test-source-token'
+process.env.MIGRATION_TARGET_TOKEN = 'migration-test-target-token'
+process.env.MIGRATION_TEST_REPO = 'larch-migration-rehearsal-20260928'
+process.env.MIGRATION_WRITE = '1'
+const config = require('./config')
+config.apiCallsPerHour = 3600000
+const migration = require('./migrationState')
+const assets = require('./releaseAssets')
+let commandHandler
+assets.gh = (...args) => commandHandler(...args)
+assets.downloadVerified = async (repo, tag, asset, directory) => path.join(directory, asset.name)
+const { createRelease, verifyDraft } = require('./createReleases')
+const response = (value, status = 200) => new Response(JSON.stringify(value), { status })
+
+test('asset allowlist and release ownership checks reject incomplete or unrelated releases', () => {
+  assert.throws(() => assets.expectedNames('../v1.2.3'), /stable version/)
+  assert.throws(() => assets.assertAssets({ tag_name: 'v1.2.3', assets: [] }), /three-file/)
+  assert.throws(() => verifyDraft({ body: 'Someone else wrote this' }, '<!-- expected -->', 'abc', 'body'), /not owned/)
+  assert.throws(() => verifyDraft({ body: '<!-- expected -->\nHuman edit' }, '<!-- expected -->', 'abc', '<!-- expected -->\nOriginal'), /body verification/)
+})
+
+test('the release exception to Actions suppression still requires completed historical cleanup', async () => {
+  const cwd = process.cwd(), previousFetch = global.fetch
+  const temporary = await fs.mkdtemp(path.join(os.tmpdir(), 'larch-release-gate-'))
+  try {
+    process.chdir(temporary)
+    global.fetch = async () => response({ enabled: true })
+    await assert.rejects(migration.open('createReleases'), /gated on verified historical/)
+  } finally {
+    await migration.close()
+    global.fetch = previousFetch
+    process.chdir(cwd)
+    await fs.remove(temporary)
+  }
+})
+
+test('release upload interruption resumes without duplicate assets, publishes only a full draft, and preserves a newer Latest', async () => {
+  const cwd = process.cwd(), previousFetch = global.fetch
+  const temporary = await fs.mkdtemp(path.join(os.tmpdir(), 'larch-release-test-'))
+  const tag = 'v1.2.3', commit = 'a'.repeat(40)
+  let remote, latest, interrupted = false, posts = 0, publications = 0, promotions = 0
+  const uploads = new Map()
+  try {
+    await fs.ensureDir(path.join(temporary, 'tool'))
+    process.chdir(path.join(temporary, 'tool'))
+    const directory = path.join(temporary, 'baseline-release', tag)
+    await fs.ensureDir(directory)
+    const archiveName = 'larch-' + tag + '-aarch64-apple-darwin.tar.gz'
+    const manifestName = 'larch-' + tag + '-manifest.json'
+    const archiveBytes = 'test artifact bytes'
