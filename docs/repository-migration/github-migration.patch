+const fs = require('fs-extra')
+const { execFileSync } = require('node:child_process')
+const config = require('./config')
+const request = require('./migrationRequest')
+const { atomicJson, fetchList } = require('./fetch')
+const migration = require('./migrationState')
+const { collectionFile } = require('./historyCollection')
+const { fileCoverage } = require('./historyFiles')
+
+const sourceApi = config.source.baseUrl + '/' + config.source.org + '/' + config.source.repo
+const headers = { Authorization: 'Bearer ' + config.source.token }
+const root = config.source.repo + '/history'
+const get = async endpoint => {
+  const file = root + '/raw/' + encodeURIComponent(endpoint) + '.json'
+  if (await fs.pathExists(file)) return fs.readJson(file)
+  const result = await request({ url: sourceApi + '/' + endpoint, headers, json: true })
+  await atomicJson(file, result)
+  return result
+}
+const checks = async sha => {
+  const records = []
+  let expected
+  for (let page = 1; ; page++) {
+    const result = await get('commits/' + sha + '/check-runs?filter=all&per_page=100&page=' + page)
+    if (!Array.isArray(result.check_runs)) throw new Error('Missing check_runs array for ' + sha)
+    expected = result.total_count
+    records.push(...result.check_runs)
+    if (result.check_runs.length < 100) break
+  }
+  if (records.length !== expected) throw new Error('Incomplete available check-run history: ' + sha)
+  if (new Set(records.map(record => record.id)).size !== records.length) throw new Error('Duplicate check-run records: ' + sha)
+  return records
+}
+const localCommits = (base, head) => execFileSync('git', ['-C', config.gitMirror, 'log', '--format=%H%x00%an%x00%ae%x00%aI%x00%cn%x00%ce%x00%cI%x00%B%x00', base + '..' + head], { encoding: 'utf8', maxBuffer: 32 * 1024 * 1024 })
+const localFiles = (base, head) => execFileSync('git', ['-C', config.gitMirror, 'diff', '--no-ext-diff', '--no-textconv', '--name-status', '-z', base + '...' + head], { encoding: 'utf8', maxBuffer: 32 * 1024 * 1024 })
+
+const main = async () => {
+  if (config.enableWrites) throw new Error('Historical source collection requires writes disabled')
+  const issues = await migration.issueFiles()
+  const pulls = issues.filter(issue => issue.pull_request)
+  const issueComments = await fs.readJson(config.source.repo + '/issue-comments.json')
+  const inlineComments = await fs.readJson(config.source.repo + '/pull-comments.json')
+  const reviews = await fs.readJson(config.source.repo + '/reviews.json')
+  const parentNumber = record => Number(String(record.issue_url || record.pull_request_url || '').split('/').pop())
+  const index = records => {
+    const map = new Map()
+    for (const record of records) { const number = parentNumber(record); const group = map.get(number) || []; group.push(record); map.set(number, group) }
+    return map
+  }
+  const issueCommentsByNumber = index(issueComments)
+  const inlineByNumber = index(inlineComments)
+  const reviewsByNumber = index(reviews)
+  let processed = 0
+  for (const pull of pulls) {
+    const file = root + '/pulls/' + pull.number + '.json'
+    if (!await fs.pathExists(file)) {
+      const detail = await get('pulls/' + pull.number)
+      if (detail.base.sha !== pull.base.sha || detail.head.sha !== pull.head.sha) throw new Error('Source PR commits changed after the snapshot: ' + pull.number)
+      const commits = await fetchList('pulls/' + pull.number + '/commits')
+      const files = await fetchList('pulls/' + pull.number + '/files')
+      const timeline = await fetchList('issues/' + pull.number + '/timeline')
+      const checkRuns = await checks(pull.head.sha)
+      const statuses = await fetchList('commits/' + pull.head.sha + '/statuses')
+      const exceptions = []
+      const uniqueFiles = new Set(files.map(file => file.filename)).size
+      if (uniqueFiles !== files.length) exceptions.push('The GitHub file list contains multiple versions of a path; every returned entry is preserved')
+      let gitCommitHistory, gitFileHistory
+      if (detail.commits !== commits.length) {
+        if (commits.length !== 250 || detail.commits < commits.length) throw new Error('Unexpected commit count mismatch: PR ' + pull.number)
+        gitCommitHistory = localCommits(pull.base.sha, pull.head.sha)
+        exceptions.push('GitHub PR commits endpoint is limited to 250; complete retained Git history is included as NUL-delimited metadata')
+      }
+      if (detail.changed_files !== uniqueFiles || files.length === 3000) {
+        if (files.length !== 3000) throw new Error('Unexpected changed-file count mismatch: PR ' + pull.number)
+        gitFileHistory = localFiles(pull.base.sha, pull.head.sha)
+        exceptions.push('GitHub PR files endpoint is limited to 3000; complete retained Git name/status history is included as NUL-delimited metadata')
+      }
+      const coverage = fileCoverage({ reportedFiles: detail.changed_files, files, gitFileHistory })
+      if (coverage.providerCounterException) exceptions.push('GitHub reports zero changed files for this capped large diff; retained Git history proves ' + coverage.completeFiles + ' paths and agrees with every available API file entry')
+      await atomicJson(file, {
+        schemaVersion: 1, sourceNumber: pull.number, sourceUrl: pull.html_url, collectedAt: new Date().toISOString(), deferred: migration.isDeferred(pull.number),
+        originalIssue: pull, pull: detail, commits, files, timeline, checks: checkRuns, statuses,
+        issueComments: issueCommentsByNumber.get(pull.number) || [], inlineComments: inlineByNumber.get(pull.number) || [], reviews: reviewsByNumber.get(pull.number) || [],
+        coverage: { expectedCommits: detail.commits, apiCommits: commits.length, expectedFiles: detail.changed_files, ...coverage, availableCheckRuns: checkRuns.length, availableStatuses: statuses.length, timelineEvents: timeline.length, originalMergedState: Boolean(detail.merged), originalMergeCommit: detail.merge_commit_sha },
+        exceptions, ...(gitCommitHistory ? { gitCommitHistory } : {}), ...(gitFileHistory ? { gitFileHistory } : {}),
+      })
+    }
+    processed++
+    if (processed % 25 === 0) {
+      await atomicJson(collectionFile('progress'), { processed, total: pulls.length, lastSourceNumber: pull.number, at: new Date().toISOString() })
+      console.log('Collected complete research history for ' + processed + '/' + pulls.length + ' source PRs')
+    }
+  }
+  const relations = { collectedAt: new Date().toISOString(), parents: [], blockedBy: [] }
+  for (const issue of issues) {
+    if (issue.sub_issues_summary?.total > 0) {
+      const children = await fetchList('issues/' + issue.number + '/sub_issues')
+      if (children.length !== issue.sub_issues_summary.total) throw new Error('Sub-issue snapshot changed: ' + issue.number)
+      relations.parents.push({ sourceNumber: issue.number, children })
+    }
+    if ((issue.issue_dependencies_summary?.total_blocked_by || issue.issue_dependencies_summary?.blocked_by || 0) > 0) {
+      const blockers = await fetchList('issues/' + issue.number + '/dependencies/blocked_by')
+      const expected = issue.issue_dependencies_summary.total_blocked_by ?? issue.issue_dependencies_summary.blocked_by
+      if (blockers.length !== expected) throw new Error('Dependency snapshot changed: ' + issue.number)
+      relations.blockedBy.push({ sourceNumber: issue.number, blockers })
+    }
+  }
+  await atomicJson(collectionFile('native-relations'), relations)
+  await atomicJson(collectionFile('collection-complete'), { completedAt: new Date().toISOString(), pulls: pulls.length, parents: relations.parents.length, blockedIssues: relations.blockedBy.length })
+  console.log('Historical source collection complete')
+}
+if (require.main === module) main().catch(error => { console.error(request.safeError(error)); process.exitCode = 1 })
+module.exports = { main, get, checks }
