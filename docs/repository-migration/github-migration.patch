@@ -0,0 +1,125 @@
+const assert = require('node:assert/strict')
+const { test } = require('node:test')
+const fs = require('fs-extra')
+const os = require('node:os')
+const path = require('node:path')
+const { spawnSync } = require('node:child_process')
+
+process.env.MIGRATION_SOURCE_TOKEN = 'migration-test-source-token'
+process.env.MIGRATION_TARGET_TOKEN = 'migration-test-target-token'
+delete process.env.MIGRATION_WRITE
+const config = require('./config')
+const request = require('./migrationRequest')
+const { fetchList } = require('./fetch')
+const source = 'https://api.github.com/repos/character-ai/larch'
+const target = 'https://api.github.com/repos/zhupanov/larch'
+
+test('unfinished write stages fail before credentials or mutations, even with the write flag set', () => {
+  const temporary = fs.mkdtempSync(path.join(os.tmpdir(), 'github-migration-guard-'))
+  try {
+  for (const stage of ['createBranches.js', 'createIssues.js', 'createComments.js', 'updateIssues.js', 'deleteBranches.js', 'repairHistoryReferences.js', 'restoreNativeRelations.js', 'buildHistoryArchive.js', 'auditHistorical.js', 'createReleases.js']) {
+    const result = spawnSync(process.execPath, [path.join(__dirname, stage)], {
+      encoding: 'utf8',
+      cwd: temporary,
+      env: { ...process.env, MIGRATION_WRITE: '1' },
+    })
+    assert.equal(result.status, 1, stage)
+    assert.match(result.stderr, /Migration is stopped/, stage)
+  }
+  } finally { fs.removeSync(temporary) }
+})
+
+test('source stays read-only and requests stay inside the repository allowlist', async () => {
+  await assert.rejects(request({ url: source + '/issues', method: 'POST' }), /Source writes/)
+  await assert.rejects(request({ url: target + '/issues', method: 'POST' }), /Destination writes/)
+  await assert.rejects(request({ url: 'https://example.org/repos/character-ai/larch' }), /outside/)
+  await assert.rejects(request({ url: source + '-other/issues' }), /outside/)
+  assert.equal(request.safeError(new Error('migration-test-source-token migration-test-target-token')), '[REDACTED] [REDACTED]')
+})
+
+test('an ambiguous destination write is never blindly retried', async () => {
+  const originalFetch = global.fetch
+  let attempts = 0
+  config.enableWrites = true
+  try {
+    global.fetch = async () => { attempts++; throw new Error('request might have succeeded') }
+    await assert.rejects(request({ url: target + '/issues', method: 'POST', body: { title: 'test' } }), /reconcile writes/)
+    assert.equal(attempts, 1)
+  } finally {
+    config.enableWrites = false
+    global.fetch = originalFetch
+  }
+})
+
+test('interrupted pagination resumes cached pages without changing their source data', async () => {
+  const originalFetch = global.fetch
+  const originalCwd = process.cwd()
+  const temporary = await fs.mkdtemp(path.join(os.tmpdir(), 'github-migration-fetch-test-'))
+  const calls = []
+  let failed = false
+  try {
+    process.chdir(temporary)
+    global.fetch = async url => {
+      const page = Number(url.searchParams.get('page'))
+      calls.push(page)
+      if (page === 1) return new Response(JSON.stringify(Array.from({ length: 100 }, (_, i) => ({ id: i + 1 }))), { status: 200 })
+      if (!failed) { failed = true; return new Response(JSON.stringify({ message: 'simulated interruption' }), { status: 400 }) }
+      return new Response(JSON.stringify([{ id: 101 }]), { status: 200 })
+    }
+    await assert.rejects(fetchList('issues'), /simulated interruption/)
+    const result = await fetchList('issues')
+    assert.equal(result.length, 101)
+    assert.deepEqual(calls, [1, 2, 2])
+    assert.equal((await fs.readJson(path.join('larch', 'raw-pages', 'issues', '1.json'))).length, 100)
+  } finally {
+    global.fetch = originalFetch
+    process.chdir(originalCwd)
+    await fs.remove(temporary)
+  }
+})
+
+test('PR file export retains type changes and distinct paths sharing a blob', async () => {
+  const originalFetch = global.fetch
+  const originalCwd = process.cwd()
+  const temporary = await fs.mkdtemp(path.join(os.tmpdir(), 'github-migration-file-history-'))
+  const files = [
+    { filename: 'agent.md', sha: 'old', status: 'removed' },
+    { filename: 'agent.md', sha: 'new', status: 'added' },
+    { filename: 'other-agent.md', sha: 'new', status: 'added' },
+  ]
+  try {
+    process.chdir(temporary)
+    global.fetch = async () => new Response(JSON.stringify(files), { status: 200 })
+    assert.deepEqual(await fetchList('pulls/28/files'), files)
+  } finally {
+    global.fetch = originalFetch
+    process.chdir(originalCwd)
+    await fs.remove(temporary)
+  }
+})
+
+test('rate-limit responses honor Retry-After before repeating a rejected request', async () => {
+  const originalFetch = global.fetch
+  const originalTimeout = global.setTimeout
+  const originalNow = Date.now
+  let now = originalNow()
+  const delays = []
+  let attempts = 0
+  try {
+    Date.now = () => now
+    global.setTimeout = (callback, delay) => { delays.push(delay); now += delay; return originalTimeout(callback, 0) }
+    global.fetch = async () => {
+      attempts++
+      return attempts === 1
+        ? new Response(JSON.stringify({ message: 'Secondary rate limit' }), { status: 429, headers: { 'retry-after': '120' } })
+        : new Response(JSON.stringify({ ok: true }), { status: 200 })
+    }
+    assert.deepEqual(await request({ url: source, json: true }), { ok: true })
+    assert.equal(attempts, 2)
+    assert.ok(delays.some(delay => delay >= 120000))
+  } finally {
+    global.fetch = originalFetch
+    global.setTimeout = originalTimeout
+    Date.now = originalNow
+  }
+})
diff --git a/migrationState.js b/migrationState.js
new file mode 100644
index 0000000..e256133
--- /dev/null
+++ b/migrationState.js
@@ -0,0 +1,154 @@
+const fs = require('fs-extra')
+const path = require('node:path')
+const os = require('node:os')
+const crypto = require('node:crypto')
+const request = require('./migrationRequest')
+const config = require('./config')
+
+const api = config.target.baseUrl + '/' + config.target.org + '/' + config.target.repo
+const headers = { Authorization: 'Bearer ' + config.target.token }
+const stateFile = path.join(config.source.repo, config.target.repo === 'larch' ? 'state.json' : 'rehearsal-state.json')
+const ledgerFile = stateFile.replace(/\.json$/, '.jsonl')
+const lockFile = stateFile + '.lock'
+let state
+let locked = false
+
+const atomicJson = async (file, value) => {
+  await fs.ensureDir(path.dirname(file))
+  const temporary = file + '.tmp-' + process.pid
+  const descriptor = fs.openSync(temporary, 'w', 0o600)
+  try {
+    fs.writeFileSync(descriptor, JSON.stringify(value, null, 2) + '\n')
+    fs.fsyncSync(descriptor)
+  } finally { fs.closeSync(descriptor) }
+  fs.renameSync(temporary, file)
+}
+const sha256 = text => crypto.createHash('sha256').update(text).digest('hex')
+const normalize = text => String(text || '').replace(/\r\n/g, '\n').trim()
+const call = (method, endpoint, body) => request({ method, url: api + endpoint, headers, body, json: true })
+const list = async endpoint => {
+  const records = []
+  for (let page = 1; ; page++) {
+    const batch = await call('GET', endpoint + (endpoint.includes('?') ? '&' : '?') + 'per_page=100&page=' + page)
+    if (!Array.isArray(batch)) throw new Error('Expected destination list: ' + endpoint)
+    records.push(...batch)
+    if (batch.length < 100) return records
+  }
+}
+const save = async () => atomicJson(stateFile, state)
+const audit = async event => {
+  const descriptor = fs.openSync(ledgerFile, 'a', 0o600)
+  try {
+    fs.writeFileSync(descriptor, JSON.stringify({ at: new Date().toISOString(), ...event }) + '\n')
+    fs.fsyncSync(descriptor)
+  } finally { fs.closeSync(descriptor) }
+}
+const open = async stage => {
+  await fs.ensureDir(path.dirname(stateFile))
+  try {
+    fs.writeFileSync(lockFile, JSON.stringify({ pid: process.pid, hostname: os.hostname(), stage }), { flag: 'wx', mode: 0o600 })
+  } catch (error) {
+    if (error.code !== 'EEXIST') throw error
+    const previous = await fs.readJson(lockFile)
+    if (previous.hostname !== os.hostname()) throw new Error('Migration is locked by a different host')
+    try { process.kill(previous.pid, 0); throw new Error('Another migration stage is running: ' + previous.stage) }
+    catch (live) { if (live.code !== 'ESRCH') throw live }
+    await fs.remove(lockFile)
+    fs.writeFileSync(lockFile, JSON.stringify({ pid: process.pid, hostname: os.hostname(), stage }), { flag: 'wx', mode: 0o600 })
+  }
+  locked = true
+  state = await fs.pathExists(stateFile) ? await fs.readJson(stateFile) : {
+    schemaVersion: 1,
+    source: config.source.org + '/' + config.source.repo,
+    target: config.target.org + '/' + config.target.repo,
+    objects: {}, comments: {}, reviews: {}, branches: {}, labels: {}, milestones: {}, pending: {}, exceptions: {}, commentUrls: {}, bodyContinuations: {}, largeBodies: {},
+  }
+  if (state.source !== config.source.org + '/' + config.source.repo || state.target !== config.target.org + '/' + config.target.repo) {
+    throw new Error('Checkpoint repository identity does not match this run')
+  }
+  state.commentUrls = state.commentUrls || {}
+  state.bodyContinuations = state.bodyContinuations || {}
+  state.largeBodies = state.largeBodies || {}
+  await save()
+  const actions = await call('GET', '/actions/permissions')
+  if (stage === 'createReleases' || stage === 'restoreConfiguration') {
+    if (!state.cleanup?.completedAt || (config.target.repo === 'larch' && !state.historyAudit?.verifiedAt)) throw new Error('Release import is gated on verified historical replay and synthetic-ref cleanup')
+  } else if (actions.enabled) throw new Error('Destination Actions must be disabled throughout historical replay')
+  return state
+}
+const close = async () => {
+  if (locked) { await fs.remove(lockFile); locked = false }
+}
+const marker = (kind, id) => '<!-- github-migration:' + config.source.org + '/' + config.source.repo + ':' + kind + ':' + id + ' -->'
+const verifyBody = (remote, expected) => {
+  if (normalize(remote.body) !== normalize(expected)) throw new Error('Destination body verification failed for ' + remote.html_url)
+}
+const findMarker = async (endpoint, expected) => {
+  const matches = (await list(endpoint)).filter(item => String(item.body || '').startsWith(expected))
+  if (matches.length > 1) throw new Error('Duplicate migration marker found: ' + expected)
+  return matches[0]
+}
+const createOnce = async ({ key, endpoint, body, recoveryEndpoint, identity, readEndpoint }) => {
+  const pending = state.pending[key]
+  const digest = sha256(JSON.stringify(body))
+  if (pending && pending.digest !== digest) throw new Error('Mutation changed while pending: ' + key)
+  let response
+  if (pending) {
+    response = pending.response || await findMarker(recoveryEndpoint(pending.startedAt), identity)
+    if (response) {
+      const readback = await call('GET', readEndpoint(response))
+      verifyBody(readback, body.body)
+      await audit({ key, action: 'reconciled-remote-success', number: readback.number, id: readback.id })
+      return readback
+    }
+    if (pending.attemptedAt) {
+      const settleFor = Math.max(0, Date.parse(pending.attemptedAt) + 90000 - Date.now())
+      if (settleFor) await new Promise(resolve => setTimeout(resolve, settleFor))
+      const reconciled = await findMarker(recoveryEndpoint(pending.startedAt), identity)
+      if (reconciled) {
+        const readback = await call('GET', readEndpoint(reconciled))
+        verifyBody(readback, body.body)
+        await audit({ key, action: 'reconciled-delayed-remote-success', number: readback.number, id: readback.id })
+        return readback
+      }
+      await audit({ key, action: 'verified-absent-before-retry' })
+    }
+  } else {
+    state.pending[key] = { startedAt: new Date().toISOString(), digest, marker: identity }
+    await save()
+  }
+  await audit({ key, action: 'create-intent', endpoint, bodySha256: sha256(body.body || '') })
+  state.pending[key].attemptedAt = new Date().toISOString()
+  await save()
+  response = await call('POST', endpoint, body)
+  // A rehearsal can interrupt here, after GitHub accepted the write but before any response is checkpointed.
+  if (process.env.MIGRATION_FAIL_AFTER_REMOTE_SUCCESS === key) {
+    throw new Error('Rehearsal interruption after remote success: ' + key)
+  }
+  state.pending[key].response = { id: response.id, number: response.number, url: response.url, html_url: response.html_url }
+  await save()
+  const readback = await call('GET', readEndpoint(response))
+  verifyBody(readback, body.body)
+  await audit({ key, action: 'created-and-read-back', number: readback.number, id: readback.id })
+  return readback
+}
+const issueFiles = async () => {
+  let records = (await fs.readdir(path.join(config.source.repo, 'issues')))
+    .filter(name => /^issue-\d+\.json$/.test(name))
+    .map(name => fs.readJsonSync(path.join(config.source.repo, 'issues', name)))
+    .sort((a, b) => a.number - b.number)
+  if (process.env.MIGRATION_SELECTION) {
+    if (config.target.repo === 'larch') throw new Error('Selections are permitted only for the rehearsal repository')
+    const selected = new Set(await fs.readJson(process.env.MIGRATION_SELECTION))
+    if (!selected.size || selected.size > 20) throw new Error('Rehearsal selection must contain between 1 and 20 source records')
+    records = records.filter(record => selected.has(record.number))
+  }
+  return records
+}
+const isDeferred = number => config.excludedPullRequests.includes(Number(number))
+const run = async (stage, main) => {
+  try { await open(stage); await main(); await audit({ stage, action: 'stage-complete' }) }
+  catch (error) { console.error(request.safeError(error)); process.exitCode = 1 }
+  finally { await close() }
+}
+module.exports = { api, headers, atomicJson, sha256, normalize, call, list, save, audit, open, close, marker, verifyBody, createOnce, issueFiles, isDeferred, run, state: () => state }
