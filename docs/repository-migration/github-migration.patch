+const assertPrerequisites = async (state, call = migration.call) => {
+  if (!state.cleanup?.completedAt || !state.historyAudit?.verifiedAt || !state.archive?.builtAt) throw new Error('Configuration restore requires the verified history archive and synthetic-ref cleanup')
+  if (!state.archive.manifestSha256 || state.historyAudit.archiveManifestSha256 !== state.archive.manifestSha256) throw new Error('Configuration restore requires the exact audited archive manifest')
+  if (state.target === 'zhupanov/larch') {
+    for (const number of [4, 5]) {
+      const leaf = await call('GET', '/issues/' + number)
+      if (leaf.state !== 'closed' || leaf.state_reason !== 'completed') throw new Error('Configuration restore requires completed leaf #' + number)
+    }
+  }
+}
+
+const reconcile = async ({ key, desired, before, read, write, ledger, save = migration.save, audit = migration.audit }) => {
+  if (ledger[key]?.desiredFingerprint && ledger[key].desiredFingerprint !== fingerprint(desired)) throw new Error('Configuration intent changed during replay: ' + key)
+  let current = await read()
+  if (same(current, desired)) {
+    ledger[key] = { ...ledger[key], desiredFingerprint: fingerprint(desired), verifiedAt: new Date().toISOString() }
+    await save()
+    return
+  }
+  if (!same(current, before)) throw new Error('A destination setting changed outside this replay: ' + key)
+  ledger[key] = { ...ledger[key], desiredFingerprint: fingerprint(desired), intentAt: new Date().toISOString() }
+  await save()
+  await audit({ action: 'configuration-intent', key, desiredFingerprint: fingerprint(desired) })
+  await write()
+  current = await read()
+  if (!same(current, desired)) throw new Error('Configuration readback differs: ' + key)
+  ledger[key].verifiedAt = new Date().toISOString()
+  await save()
