--- /dev/null
+++ b/historyCorpus.js
@@ -0,0 +1,63 @@
+const fs = require('fs-extra')
+const config = require('./config')
+const migration = require('./migrationState')
+
+const numberOf = record => Number(String(record.issue_url || record.pull_request_url || '').split('/').pop())
+const discussion = async selected => {
+  const groups = [
+    ['issue-comment', 'issue-comments.json'],
+    ['pull-comment', 'pull-comments.json'],
+    ['review', 'reviews.json'],
+  ]
+  const items = []
+  const seen = new Set()
+  for (const [kind, file] of groups) {
+    for (const record of await fs.readJson(config.source.repo + '/' + file)) {
+      const number = numberOf(record)
+      if (selected && !selected.has(number)) continue
+      const key = kind + ':' + record.id
+      if (seen.has(key)) throw new Error('Duplicate source discussion identity: ' + key)
+      seen.add(key)
+      items.push({ key, kind, number, record })
+    }
+  }
+  return items.sort((a, b) => String(a.record.created_at || a.record.submitted_at || '').localeCompare(String(b.record.created_at || b.record.submitted_at || '')) || a.record.id - b.record.id)
+}
+
+const inlineContext = (record, number, commentUrls = {}) => {
+  let text = 'Original inline review location: `' + record.path + '` at commit `' + (record.original_commit_id || record.commit_id) + '`.'
+  if (record.in_reply_to_id) {
+    const source = 'https://github.com/' + config.source.org + '/' + config.source.repo + '/pull/' + number + '#discussion_r' + record.in_reply_to_id
+    text += '\n\nReply to original review comment [' + record.in_reply_to_id + '](' + (commentUrls[source] || source) + ').'
+  }
+  if (record.diff_hunk) text += '\n\nOriginal diff context:\n\n```diff\n' + record.diff_hunk + '\n```'
+  return text
+}
+
+const assertReplayComplete = async (state, allowedPendingKeys = new Set()) => {
+  if (!state.commentStage?.completedAt) throw new Error('Historical discussion import has not completed')
+  const records = await migration.issueFiles()
+  const destinations = new Set()
+  for (const source of records) {
+    if (migration.isDeferred(source.number)) {
+      if (state.objects[source.number]?.status === 'verified') throw new Error('Deferred live PR was imported early')
+      continue
+    }
+    const target = state.objects[source.number]
+    if (!target || target.status !== 'verified' || !target.metadataVerifiedAt) throw new Error('Historical metadata has not been verified: ' + source.number)
+    if (config.target.repo === 'larch' && target.targetNumber < 10) throw new Error('Mapping overlaps the preserved planning issues')
+    if (destinations.has(target.targetNumber)) throw new Error('Two source objects share a destination number')
+    destinations.add(target.targetNumber)
+  }
+  if (Object.keys(state.pending).some(key => !allowedPendingKeys.has(key))) throw new Error('Unresolved historical writes remain')
+  return records
+}
+
+const assertReplayAudited = async state => {
+  if (config.target.repo !== 'larch') return
+  if (!state.replayAudit?.verifiedAt) throw new Error('Leaf #5 requires the completed independent replay audit from leaf #4')
+  const leaf = await migration.call('GET', '/issues/4')
+  if (leaf.state !== 'closed' || leaf.state_reason !== 'completed') throw new Error('Leaf #4 must be completed before leaf #5 changes historical data')
+}
+
+module.exports = { numberOf, discussion, inlineContext, assertReplayComplete, assertReplayAudited }
