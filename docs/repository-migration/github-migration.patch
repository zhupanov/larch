+test('archive coverage retains duplicate file-path versions and rejects missing history', () => {
+  const raw = { sourceNumber: 28, sourceUrl: 'https://github.com/character-ai/larch/pull/28', originalIssue: { number: 28 }, pull: { number: 28, commits: 1, changed_files: 1 }, commits: [{ sha: 'a' }], files: [{ filename: 'link', status: 'removed' }, { filename: 'link', status: 'added' }], issueComments: [], inlineComments: [], reviews: [], checks: [], statuses: [], timeline: [] }
+  const links = { sourceNumber: 28, sourceUrl: raw.sourceUrl, closingIssues: [] }
+  const mapping = { status: 'verified', targetNumber: 37, targetKind: 'pull', targetUrl: 'https://github.com/zhupanov/larch/pull/37' }
+  const archived = composePullArchive(raw, links, mapping, [])
+  assert.equal(archived.coverage.fileEntries, 2)
+  assert.equal(archived.coverage.uniqueFiles, 1)
+  assert.equal(archived.original.files[0].status, 'removed')
+  assert.throws(() => composePullArchive({ ...raw, commits: [] }, links, mapping, []), /Incomplete retained commit/)
+  assert.throws(() => composePullArchive(raw, { ...links, sourceNumber: 29 }, mapping, []), /different source PR/)
+})
