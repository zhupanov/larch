--- /dev/null
+++ b/historyCollection.js
@@ -0,0 +1,29 @@
+const fs = require('fs-extra')
+const config = require('./config')
+
+const prefix = () => config.target.repo === 'larch' ? '' : 'rehearsal-'
+const collectionFile = name => config.source.repo + '/history/' + prefix() + name + '.json'
+const validateCollection = (records, marker, relations) => {
+  if (marker.pulls !== records.filter(record => record.pull_request).length) throw new Error('History completion marker covers a different PR selection')
+  const selected = new Set(records.map(record => record.number))
+  for (const [groups, expected] of [
+    [relations.parents, record => record.sub_issues_summary?.total || 0],
+    [relations.blockedBy, record => record.issue_dependencies_summary?.total_blocked_by ?? record.issue_dependencies_summary?.blocked_by ?? 0],
+  ]) {
+    const byNumber = new Map(groups.map(group => [group.sourceNumber, group]))
+    if (byNumber.size !== groups.length) throw new Error('Duplicate source relationship collection')
+    for (const record of records) {
+      const group = byNumber.get(record.number)
+      if ((group?.children || group?.blockers || []).length !== expected(record)) throw new Error('Native relationship coverage differs from the original snapshot: ' + record.number)
+    }
+    if (groups.some(group => !selected.has(group.sourceNumber))) throw new Error('Relationship collection contains records outside this selection')
+  }
+}
+const loadCollection = async records => {
+  if (!await fs.pathExists(collectionFile('collection-complete'))) throw new Error('Source research-history collection is incomplete')
+  const marker = await fs.readJson(collectionFile('collection-complete'))
+  const relations = await fs.readJson(collectionFile('native-relations'))
+  validateCollection(records, marker, relations)
+  return { marker, relations }
+}
+module.exports = { collectionFile, validateCollection, loadCollection }
