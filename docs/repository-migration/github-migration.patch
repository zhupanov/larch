+const assert = require('node:assert/strict')
+const { test } = require('node:test')
+const fs = require('fs-extra')
+const path = require('node:path')
+const os = require('node:os')
+process.env.MIGRATION_SOURCE_TOKEN = 'migration-test-source-token'
+process.env.MIGRATION_TARGET_TOKEN = 'migration-test-target-token'
+process.env.MIGRATION_TEST_REPO = 'larch-migration-rehearsal-20260928'
+process.env.MIGRATION_WRITE = '1'
+const config = require('./config')
+config.apiCallsPerHour = 3600000
+const migration = require('./migrationState')
+const { createIssue, createPull } = require('./createIssues')
+const { createComment, postComment } = require('./createComments')
+const { render } = require('./migrationContent')
+
+test('remote success before checkpoint resumes once and follows actual numbers across interference', async () => {
+  const cwd = process.cwd()
+  const temporary = await fs.mkdtemp(path.join(os.tmpdir(), 'github-migration-replay-'))
+  const originalFetch = global.fetch
+  const remote = [{ number: 9, id: 99, body: 'Existing planning issue' }]
+  let posts = 0
+  const response = data => new Response(JSON.stringify(data), { status: 200 })
+  const source = number => ({ number, id: 100000 + number, title: 'Source ' + number, body: 'Original text with #2.', user: { login: 'original-author', html_url: 'https://github.com/original-author' }, created_at: '2026-01-01T00:00:00Z', html_url: 'https://github.com/character-ai/larch/issues/' + number })
+  try {
+    process.chdir(temporary)
+    global.fetch = async (url, options) => {
+      if (url.pathname.endsWith('/actions/permissions')) return response({ enabled: false })
+      if (options.method === 'POST') {
+        const body = JSON.parse(options.body)
+        const number = Math.max(...remote.map(x => x.number)) + 1
+        const result = { ...body, number, id: 90000 + number, node_id: 'I_' + number, html_url: 'https://github.com/zhupanov/larch-migration-rehearsal-20260928/issues/' + number }
+        remote.push(result); posts++
+        return response(result)
+      }
+      const match = url.pathname.match(/\/issues\/(\d+)$/)
+      if (match) return response(remote.find(x => x.number === Number(match[1])))
+      if (url.pathname.endsWith('/issues')) return response(remote)
+      throw new Error('Unexpected request')
+    }
+    await migration.open('test-create')
+    process.env.MIGRATION_FAIL_AFTER_REMOTE_SUCCESS = 'object:101'
+    await assert.rejects(createIssue(source(101)), /after remote success/)
+    assert.equal(posts, 1)
+    assert.equal(migration.state().objects[101], undefined)
+    await migration.close()
+    delete process.env.MIGRATION_FAIL_AFTER_REMOTE_SUCCESS
+    remote.push({ number: 11, id: 100, body: 'Planning issue added during interruption' })
+    await migration.open('test-resume')
+    await createIssue(source(101))
+    assert.equal(posts, 1)
+    assert.equal(migration.state().objects[101].targetNumber, 10)
+    await createIssue(source(105))
+    assert.equal(migration.state().objects[105].targetNumber, 12)
+    assert.equal(remote[0].body, 'Existing planning issue')
+    await assert.rejects(createIssue(source(9076)), /deferred/)
+    await assert.rejects(postComment({ id: 1 }, 'issue-comment', 9076, 'text', 'marker'), /deferred/)
+    assert.equal(posts, 2)
+
+    migration.state().exceptions['pr:106'] = { reason: 'The historical base and head point to the same commit' }
+    await createPull({ ...source(106), pull_request: {}, base: { sha: 'same' }, head: { sha: 'same' } })
+    assert.equal(migration.state().objects[106].targetKind, 'issue')
+    assert.match(migration.state().objects[106].archivalException, /same commit/)
+    assert.equal(posts, 3)
+
+    global.fetch = async (url, options) => {
+      if (options.method === 'POST') return new Response(JSON.stringify({ message: 'Review replay rejected in test' }), { status: 422 })
+      throw new Error('Unexpected request')
+    }
+    await assert.rejects(createComment({ kind: 'review', number: 101, record: { id: 555, state: 'COMMENTED', body: 'A review', user: { login: 'reviewer' }, html_url: 'https://github.com/character-ai/larch/pull/101#pullrequestreview-555' } }), /Review replay rejected/)
+    assert.equal(migration.state().comments['review:555'], undefined)
+  } finally {
+    delete process.env.MIGRATION_FAIL_AFTER_REMOTE_SUCCESS
+    await migration.close()
+    process.chdir(cwd)
+    global.fetch = originalFetch
+    await fs.remove(temporary)
+  }
+})
+
+test('oversized descriptions split without losing text or splitting Unicode characters', async () => {
+  const original = 'Example #17\n'.repeat(6000) + '😀'.repeat(500)
+  const rendered = await render({ id: 1, body: original, created_at: '2026-01-01T00:00:00Z' }, 'object')
+  assert.ok(rendered.body.length < 60000)
+  assert.ok(rendered.parts.length > 1)
+  assert.equal(rendered.parts.join(''), original)
+  for (const part of rendered.parts) assert.ok(part.isWellFormed())
+})
+
+test('metadata replay preserves a human edit made after import', async () => {
+  const cwd = process.cwd()
+  const temporary = await fs.mkdtemp(path.join(os.tmpdir(), 'github-migration-human-edit-'))
+  const originalFetch = global.fetch
+  const source = { number: 5, id: 500, title: 'Historical issue', body: 'Original description', state: 'closed', state_reason: 'completed', labels: [], assignees: [], html_url: 'https://github.com/character-ai/larch/issues/5' }
+  let patches = 0
+  try {
+    process.chdir(temporary)
+    await fs.ensureDir('larch/issues')
+    await fs.writeJson('larch/issues/issue-5.json', source)
+    const rendered = await render(source, 'object')
+    const remote = { id: 42, number: 42, title: source.title, body: rendered.body + '\n\nA human added this.', state: 'open', labels: [], assignees: [], milestone: null }
+    global.fetch = async (url, options) => {
+      if (url.pathname.endsWith('/actions/permissions')) return new Response(JSON.stringify({ enabled: false }), { status: 200 })
+      if (options.method === 'PATCH') { patches++; Object.assign(remote, JSON.parse(options.body)) }
+      return new Response(JSON.stringify(remote), { status: 200 })
+    }
+    await migration.open('test-human-edit')
+    const state = migration.state()
+    state.metadataProvisionedAt = new Date().toISOString()
+    state.assignees = {}
+    state.objects[5] = { status: 'verified', targetNumber: 42, targetKind: 'issue', marker: rendered.identity, bodySha256: migration.sha256(migration.normalize(rendered.body)) }
+    await assert.rejects(require('./updateIssues').main(), /edited outside the migration/)
+    assert.equal(patches, 0)
+    assert.match(remote.body, /A human added this/)
+    remote.body = rendered.body
+    await require('./updateIssues').main()
+    assert.equal(patches, 1)
+    assert.equal(remote.state, 'closed')
+    assert.equal(remote.state_reason, 'completed')
+  } finally {
+    await migration.close()
+    process.chdir(cwd)
+    global.fetch = originalFetch
+    await fs.remove(temporary)
+  }
+})
diff --git a/migrationRequest.js b/migrationRequest.js
new file mode 100644
index 0000000..126f712
--- /dev/null
+++ b/migrationRequest.js
@@ -0,0 +1,85 @@
+const config = require('./config')
+
+const sleep = (ms) => new Promise(resolve => setTimeout(resolve, ms))
+let nextReadAt = 0
+let nextWriteAt = 0
+const secrets = [config.source.token, config.target.token, config.target.commentToken].filter(Boolean)
+const safeError = (error) => {
+  let message = String(error && error.message || error)
+  for (const secret of secrets) message = message.split(secret).join('[REDACTED]')
+  return message.slice(0, 1500)
+}
+
+const request = async (options) => {
+  const url = new URL(options.url || options.uri)
+  const sourcePath = '/repos/' + config.source.org + '/' + config.source.repo
+  const targetPath = '/repos/' + config.target.org + '/' + config.target.repo
+  const method = String(options.method || 'GET').toUpperCase()
+  const inRepo = prefix => url.pathname === prefix || url.pathname.startsWith(prefix + '/')
+  const isSource = inRepo(sourcePath)
+  const isTarget = inRepo(targetPath)
+  if (url.origin !== 'https://api.github.com' || (!isSource && !isTarget)) {
+    throw new Error('Request outside the configured GitHub repositories')
+  }
+  if (isSource && method !== 'GET') throw new Error('Source writes are prohibited')
+  if (isTarget && method !== 'GET' && !config.enableWrites) {
+    throw new Error('Destination writes are disabled; set MIGRATION_WRITE=1 for a validated stage')
+  }
+  const isWrite = method !== 'GET'
+  for (let attempt = 0; attempt < 6; attempt++) {
+    const waitUntil = Math.max(nextReadAt, isWrite ? nextWriteAt : 0)
+    if (waitUntil > Date.now()) {
+      await sleep(waitUntil - Date.now())
+    }
+    if (isWrite) nextWriteAt = Date.now() + Math.ceil(3600000 / config.apiCallsPerHour)
+    let response
+    try {
+      response = await fetch(url, {
+        method,
+        headers: {
+          Accept: 'application/vnd.github+json',
+          ...(options.body === undefined ? {} : { 'Content-Type': 'application/json' }),
+          'User-Agent': 'larch-repository-migration',
+          'X-GitHub-Api-Version': '2022-11-28',
+          ...options.headers,
+        },
+        body: options.body === undefined ? undefined : JSON.stringify(options.body),
+        redirect: 'error',
+        signal: AbortSignal.timeout(60000),
+      })
+    } catch (_) {
+      if (!isWrite && attempt < 5) {
+        await sleep(1000 * (2 ** attempt))
+        continue
+      }
+      throw new Error(method + ' ' + url.pathname + ': transport failed; reconcile writes before retrying')
+    }
+    const responseText = await response.text()
+    let data
+    try { data = responseText ? JSON.parse(responseText) : null } catch (_) { data = null }
+    if (response.headers.get('x-ratelimit-remaining') === '0') {
+      nextReadAt = Number(response.headers.get('x-ratelimit-reset')) * 1000 + 2000
+    }
+    if (response.ok) return options.json ? data : responseText
+    const message = data && data.message || response.statusText
+    const retryAfter = Number(response.headers.get('retry-after') || 0)
+    const rateLimited = response.status === 429 ||
+      ([403, 422].includes(response.status) && (retryAfter > 0 || /rate limit|secondary rate|abuse detection|submitted too quickly|spam detection/i.test(message)))
+    if (rateLimited && attempt < 5) {
+      const delay = Math.max(retryAfter * 1000, nextReadAt - Date.now(), 60000 * (2 ** attempt))
+      console.log('GitHub rate limit: waiting ' + Math.ceil(delay / 1000) + ' seconds before retry')
+      nextReadAt = Date.now() + delay
+      continue
+    }
+    if (!isWrite && response.status >= 500 && attempt < 5) {
+      await sleep(1000 * (2 ** attempt))
+      continue
+    }
+    const error = new Error(method + ' ' + url.pathname + ': HTTP ' + response.status + ': ' + message)
+    error.statusCode = response.status
+    error.error = data
+    throw error
+  }
+}
+request.safeError = safeError
+module.exports = request
