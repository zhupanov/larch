+const config = require('./config')
+const sourceSlug = config.source.org + '/' + config.source.repo
+const sourceBase = 'https://github.com/' + sourceSlug
+let parser
+
+const escapeRegExp = value => value.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')
+const sourceUrlPattern = new RegExp('https://github\\.com/' + escapeRegExp(sourceSlug) + '/(issues|pull)/(\\d+)(#[A-Za-z0-9_-]+)?(?=$|[\\s)>\\].,?!])', 'g')
+
+const rewrite = async (content, mapping = {}, commentUrls = {}) => {
+  content = String(content || '')
+  if (!parser) parser = (await import('mdast-util-from-markdown')).fromMarkdown
+  const tree = parser(content)
+  const edits = []
+  const targetUrl = (number, kind = 'issues', anchor = '', historical = false) => {
+    const original = sourceBase + '/' + kind + '/' + number + anchor
+    if (historical || config.excludedPullRequests.includes(Number(number))) return original
+    if (anchor) return commentUrls[original] || original
+    const destination = mapping[number]
+    return destination && destination.status === 'verified' ? destination.targetUrl : original
+  }
+  const rewriteUrls = (text, historical) => text.replace(sourceUrlPattern, (original, kind, number, anchor = '') => targetUrl(number, kind, anchor, historical))
+  const rewriteText = (text, historical) => {
+    // Keep complete links, escapes, and inline code out of the bare-reference matcher.
+    const protectedParts = []
+    const protect = value => { const index = protectedParts.push(value) - 1; return '\u0000MIGRATION' + index + '\u0000' }
+    text = text.replace(sourceUrlPattern, (original, kind, number, anchor = '') => protect(targetUrl(number, kind, anchor, historical)))
+    const qualified = new RegExp('(?<![A-Za-z0-9_./\\\\])' + escapeRegExp(sourceSlug) + '#(\\d+)\\b', 'g')
+    // Qualified references are handled before generic repository references.
+    text = text.replace(qualified, (original, number) => protect('[' + original + '](' + targetUrl(number, 'issues', '', historical) + ')'))
+    text = text.replace(/(?:https?:\/\/|\b[A-Za-z0-9_.-]+\/[A-Za-z0-9_.-]+#)[^\s<>)]*/g, value => protect(value))
+    text = text.replace(/(?<![\\\w/])#(\d+)\b/g, (original, number) => '[' + original + '](' + targetUrl(number, 'issues', '', historical) + ')')
+    // Preserve the visible username while avoiding new notification mentions.
+    text = text.replace(/(?<![\\\w/])@([A-Za-z0-9][A-Za-z0-9-]{0,38})(?![\w/-])/g, (original, login) => '[' + original + '](https://github.com/' + login + ')')
+    return text.replace(/\u0000MIGRATION(\d+)\u0000/g, (_, index) => protectedParts[Number(index)])
+  }
+  const visit = (node, historical = false) => {
+    if (['code', 'inlineCode', 'html', 'image', 'imageReference', 'linkReference'].includes(node.type)) return
+    if (node.type === 'blockquote') historical = true
+    if (['link', 'definition'].includes(node.type)) {
+      const start = node.position.start.offset
+      const end = node.position.end.offset
+      const raw = content.slice(start, end)
+      const replaced = rewriteUrls(raw, historical)
+      if (replaced !== raw) edits.push({ start, end, value: replaced })
+      return
+    }
+    if (node.type === 'text') {
+      const start = node.position.start.offset
+      const end = node.position.end.offset
+      const raw = content.slice(start, end)
+      const replaced = rewriteText(raw, historical)
+      if (replaced !== raw) edits.push({ start, end, value: replaced })
+    }
+    for (const child of node.children || []) visit(child, historical)
+  }
+  visit(tree)
+  for (const edit of edits.sort((a, b) => b.start - a.start)) {
+    content = content.slice(0, edit.start) + edit.value + content.slice(edit.end)
+  }
+  return content
+}
+const rewriteTitle = (content, mapping = {}) => {
+  const protectedParts = []
+  const protect = value => '\u0000TITLE' + (protectedParts.push(value) - 1) + '\u0000'
+  const mapped = number => {
+    const value = mapping[number]
+    if (value?.status !== 'verified') return null
+    if (!Number.isInteger(value.targetNumber) || value.targetNumber <= 0) throw new Error('Invalid destination number in title reference mapping')
+    return value
+  }
+  content = String(content || '').replace(/`+[^`]*`+/g, protect)
+  content = content.replace(sourceUrlPattern, (original, kind, number, anchor) => protect(!anchor && mapped(number) ? mapped(number).targetUrl : original))
+  const qualified = new RegExp('(?<![A-Za-z0-9_./\\\\])' + escapeRegExp(sourceSlug) + '#(\\d+)\\b', 'g')
+  content = content.replace(qualified, (original, number) => protect(mapped(number) ? config.target.org + '/' + config.target.repo + '#' + mapped(number).targetNumber : original))
+  content = content.replace(/(?:https?:\/\/|\b[A-Za-z0-9_.-]+\/[A-Za-z0-9_.-]+#)[^\s<>)]*/g, protect)
+  content = content.replace(/(?<![\\\w/])#(\d+)\b/g, (original, number) => mapped(number) ? '#' + mapped(number).targetNumber : sourceSlug + '#' + number)
+  content = content.replace(/\[LEAF OF (\d+)\]/g, (original, number) => mapped(number) ? '[LEAF OF ' + mapped(number).targetNumber + ']' : original)
+  return content.replace(/\u0000TITLE(\d+)\u0000/g, (_, index) => protectedParts[Number(index)])
+}
+
+module.exports = { rewrite, rewriteTitle }
diff --git a/migrationReferences.test.js b/migrationReferences.test.js
new file mode 100644
index 0000000..bcdae75
--- /dev/null
+++ b/migrationReferences.test.js
@@ -0,0 +1,61 @@
+const assert = require('node:assert/strict')
+const { test } = require('node:test')
+process.env.MIGRATION_SOURCE_TOKEN = 'migration-test-source-token'
+process.env.MIGRATION_TARGET_TOKEN = 'migration-test-target-token'
+const { rewrite, rewriteTitle } = require('./migrationReferences')
+const { objectPresentation } = require('./migrationContent')
+const source = 'https://github.com/character-ai/larch'
+const target = 'https://github.com/zhupanov/larch'
+const mapping = { 12: { status: 'verified', targetNumber: 21, targetUrl: target + '/pull/21' } }
+
+test('bare and qualified references use returned destination mappings, with gaps', async () => {
+  assert.equal(await rewrite('See #12 and #12, character-ai/larch#12 and #13.', mapping),
+    'See [#12](' + target + '/pull/21) and [#12](' + target + '/pull/21), [character-ai/larch#12](' + target + '/pull/21) and [#13](' + source + '/issues/13).')
+})
+
+test('source URLs and known comment anchors map; unresolved and deferred anchors retain source', async () => {
+  const commentUrls = { [source + '/pull/12#issuecomment-111']: target + '/pull/21#issuecomment-999' }
+  assert.equal(await rewrite('[comment](' + source + '/pull/12#issuecomment-111)', mapping, commentUrls),
+    '[comment](' + target + '/pull/21#issuecomment-999)')
+  assert.equal(await rewrite(source + '/pull/12#discussion_r222', mapping), source + '/pull/12#discussion_r222')
+  assert.equal(await rewrite('#9076', mapping), '[#9076](' + source + '/issues/9076)')
+  assert.equal(await rewrite(source + '/pull/12/files#r333', mapping), source + '/pull/12/files#r333')
+})
+
+test('code, cross-repository links, escapes, and historical quotation context are preserved', async () => {
+  const code = '```sh\necho "#12"\n```\n\n`#12`';
+  assert.equal(await rewrite(code, mapping), code)
+  assert.equal(await rewrite('other/repo#12 https://github.com/other/repo/issues/12', mapping),
+    'other/repo#12 https://github.com/other/repo/issues/12')
+  assert.equal(await rewrite('> Historical #12', mapping), '> Historical [#12](' + source + '/issues/12)')
+  assert.equal(await rewrite('\\#12', mapping), '\\#12')
+})
+
+test('plain titles remap real numbers without introducing Markdown link syntax or destination collisions', () => {
+  assert.equal(rewriteTitle('Fixes #12: Implement issue #12 [LEAF OF 12]', mapping), 'Fixes #21: Implement issue #21 [LEAF OF 21]')
+  assert.equal(rewriteTitle('Related character-ai/larch#12 and #13 and #9076', mapping), 'Related zhupanov/larch#21 and character-ai/larch#13 and character-ai/larch#9076')
+  assert.equal(rewriteTitle('See ' + source + '/pull/12', mapping), 'See ' + target + '/pull/21')
+  assert.equal(rewriteTitle('other/repo#12 `#12` \\#12 https://example.com/#12', mapping), 'other/repo#12 `#12` \\#12 https://example.com/#12')
+  assert.equal(rewriteTitle(source + '/pull/12#issuecomment-99', mapping), source + '/pull/12#issuecomment-99')
+})
+
+test('deferred title references resolve only after the final PR receives a verified mapping', () => {
+  const deferred = { 9076: { status: 'deferred' } }
+  assert.equal(rewriteTitle('Follow #9076', deferred), 'Follow character-ai/larch#9076')
+  assert.equal(rewriteTitle('Follow #9076', { 9076: { status: 'verified', targetNumber: 9199, targetUrl: target + '/pull/9199' } }), 'Follow #9199')
+  assert.throws(() => rewriteTitle('#12', { 12: { status: 'verified' } }), /Invalid destination number/)
+})
+
+test('overlong remapped titles keep both complete titles in the description without splitting a reference', () => {
+  const title = 'Historical report: ' + Array(70).fill('#12').join(', ')
+  const result = objectPresentation({ title }, mapping)
+  assert.ok(result.title.length <= 256)
+  assert.match(result.title, /full title in description\)$/)
+  assert.ok(result.extra.includes(title))
+  assert.ok(result.extra.includes(rewriteTitle(title, mapping)))
+  assert.equal(result.titleException.completeTitlesRetainedIn, 'description')
+  assert.match(result.extra, /```markdown/)
+  const unicode = objectPresentation({ title: '🦀'.repeat(400) }, {})
+  assert.ok(unicode.title.length <= 256)
+  assert.equal(unicode.title.isWellFormed(), true)
+})
