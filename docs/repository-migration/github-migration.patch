+  if (!same(validated.desired, plan.desired)) throw new Error('Configuration payload differs from the validated plan')
+  state.configuration = state.configuration || { operations: {} }
+  const ledger = state.configuration.operations
+  const get = endpoint => migration.call('GET', endpoint)
+  const applySetting = (key, desired, before, read, write) => reconcile({ key, desired, before, read, write, ledger })
+  await applySetting('repository', plan.desired.repository, repositoryPolicy(plan.targetSnapshot.repository),
+    async () => repositoryPolicy(await get('')), () => migration.call('PATCH', '', plan.desired.repository))
+  await applySetting('topics', plan.desired.topics, plan.targetSnapshot.repository.topics,
+    async () => (await get('/topics')).names, () => migration.call('PUT', '/topics', { names: plan.desired.topics }))
+  for (const [key, endpoint] of [['workflowPermissions', '/actions/permissions/workflow'], ['forkApproval', '/actions/permissions/fork-pr-contributor-approval']]) {
+    await applySetting(key, plan.desired[key], plan.targetSnapshot[key], () => get(endpoint), () => migration.call('PUT', endpoint, plan.desired[key]))
+  }
+  await applySetting('immutableReleases', true, plan.targetSnapshot.immutableReleases.enabled,
+    async () => (await get('/immutable-releases')).enabled, () => migration.call('PUT', '/immutable-releases'))
+  await applySetting('vulnerabilityAlerts', plan.desired.vulnerabilityAlerts, plan.targetSnapshot.vulnerabilityAlerts.present,
+    async () => (await optional(() => get('/vulnerability-alerts'))).present,
+    () => migration.call(plan.desired.vulnerabilityAlerts ? 'PUT' : 'DELETE', '/vulnerability-alerts'))
+  for (const desired of plan.desired.rulesets) {
+    let existing
