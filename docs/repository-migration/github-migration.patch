+const assert = require('node:assert/strict')
+const { test } = require('node:test')
+process.env.MIGRATION_SOURCE_TOKEN = 'migration-test-source-token'
+process.env.MIGRATION_TARGET_TOKEN = 'migration-test-target-token'
+process.env.MIGRATION_TEST_REPO = 'larch-migration-rehearsal-20260928'
+const { personalRuleset, assertPrerequisites, reconcile } = require('./repositoryConfiguration')
+
+const sourceRule = () => ({ name: 'CI and branch safety', source_type: 'Repository', target: 'branch', enforcement: 'active',
+  conditions: { ref_name: { include: ['refs/heads/main'], exclude: [] } }, bypass_actors: [],
+  rules: [{ type: 'merge_queue', parameters: { merge_method: 'SQUASH' } },
+    { type: 'required_status_checks', parameters: { strict_required_status_checks_policy: false, required_status_checks: [{ context: 'rust-gate', integration_id: 15368 }] } },
+    { type: 'pull_request', parameters: { required_approving_review_count: 0, allowed_merge_methods: ['merge', 'squash', 'rebase'] } },
+    { type: 'non_fast_forward' }],
+})
+
+test('the personal-repository fallback preserves checks, restricts main to squash, and requires an up-to-date branch', () => {
+  const original = sourceRule(), result = personalRuleset(original)
+  assert.equal(result.rules.some(rule => rule.type === 'merge_queue'), false)
+  const checks = result.rules.find(rule => rule.type === 'required_status_checks').parameters
+  assert.equal(checks.strict_required_status_checks_policy, true)
+  assert.deepEqual(checks.required_status_checks, [{ context: 'rust-gate', integration_id: 15368 }])
+  assert.deepEqual(result.rules.find(rule => rule.type === 'pull_request').parameters.allowed_merge_methods, ['squash'])
+  assert.equal(result.rules.some(rule => rule.type === 'non_fast_forward'), true)
+  assert.equal(original.rules[0].type, 'merge_queue')
+})
+
+test('organization rules and bypass identities cannot be silently copied to a personal repository', () => {
+  assert.throws(() => personalRuleset({ ...sourceRule(), source_type: 'Organization' }), /inherited/)
+  assert.throws(() => personalRuleset({ ...sourceRule(), bypass_actors: [{ actor_type: 'Team', actor_id: 42, bypass_mode: 'always' }] }), /organization-specific/)
+  const changed = sourceRule()
+  changed.rules[0].parameters.merge_method = 'MERGE'
+  assert.throws(() => personalRuleset(changed), /squash-only/)
+  const external = sourceRule()
+  external.rules[1].parameters.required_status_checks[0].integration_id = 42
+  assert.throws(() => personalRuleset(external), /external app/)
+})
+
+test('CI restoration requires the archive, history audit, cleanup, and completed prerequisite leaves', async () => {
+  const state = { target: 'zhupanov/larch', cleanup: { completedAt: 'now' }, historyAudit: { verifiedAt: 'now', archiveManifestSha256: 'a'.repeat(64) }, archive: { builtAt: 'now', manifestSha256: 'a'.repeat(64) } }
+  const calls = []
+  const read = async (method, endpoint) => { calls.push([method, endpoint]); return { state: 'closed', state_reason: 'completed' } }
+  await assertPrerequisites(state, read)
+  assert.deepEqual(calls, [['GET', '/issues/4'], ['GET', '/issues/5']])
+  await assert.rejects(assertPrerequisites({ ...state, archive: {} }, read), /archive/)
+  await assert.rejects(assertPrerequisites({ ...state, archive: { ...state.archive, manifestSha256: 'b'.repeat(64) } }, read), /exact audited archive/)
+  await assert.rejects(assertPrerequisites(state, async () => ({ state: 'open' })), /completed leaf/)
+  await assert.rejects(assertPrerequisites(state, async () => ({ state: 'closed', state_reason: 'not_planned' })), /completed leaf/)
+})
+
+test('a lost successful settings response is reconciled without another write', async () => {
+  let remote = false, writes = 0
+  const ledger = {}
+  const input = { key: 'actions', before: false, desired: true, ledger, read: async () => remote,
+    write: async () => { remote = true; writes++; throw new Error('Lost response') }, save: async () => {}, audit: async () => {} }
+  await assert.rejects(reconcile(input), /Lost response/)
+  assert.ok(ledger.actions.intentAt)
+  await reconcile(input)
+  await reconcile(input)
+  assert.equal(writes, 1)
+  assert.ok(ledger.actions.verifiedAt)
+})
+
+test('unexpected owner edits stop settings replay before a mutation', async () => {
+  let writes = 0
+  await assert.rejects(reconcile({ key: 'description', before: 'Original', desired: 'Migrated', ledger: {},
+    read: async () => 'Owner changed this', write: async () => { writes++ }, save: async () => {}, audit: async () => {} }), /changed outside/)
