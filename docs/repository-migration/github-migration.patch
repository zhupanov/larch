index 0000000..b6af292
--- /dev/null
+++ b/migrationContent.js
@@ -0,0 +1,60 @@
+const fs = require('fs-extra')
+const config = require('./config')
+const { rewrite, rewriteTitle } = require('./migrationReferences')
+const createMessage = require('./createMessage')
+const migration = require('./migrationState')
+
+const limit = 65000
+const originalBlock = body => {
+  const text = String(body || '')
+  const fence = '`'.repeat(Math.max(3, ...Array.from(text.matchAll(/`+/g), item => item[0].length + 1)))
+  return fence + 'markdown\n' + text + '\n' + fence
+}
+const objectPresentation = (record, mapping, target = {}) => {
+  const fullTitle = rewriteTitle(record.title, mapping)
+  let title = fullTitle, titleException
+  const extras = target.archivalException ? ['Historical pull request preserved as an issue archive. Reason: ' + target.archivalException + '.'] : []
+  if (fullTitle.length > 256) {
+    const suffix = '… (full title in description)'
+    let prefix = fullTitle.slice(0, 256 - suffix.length)
+    if (/[\uD800-\uDBFF]$/.test(prefix)) prefix = prefix.slice(0, -1)
+    prefix = prefix.replace(/\s+\S*$/, '').trimEnd()
+    title = prefix + suffix
+    titleException = { reason: 'GitHub rejects changed titles longer than 256 characters', originalCharacters: record.title.length, mappedCharacters: fullTitle.length, completeTitlesRetainedIn: 'description' }
+    extras.push('GitHub limits changed titles to 256 characters. The full title and its resolved references are retained here.\n\nOriginal full title:\n\n' + originalBlock(record.title) + '\n\nFull title with destination references:\n\n' + fullTitle)
+  }
+  return { title, extra: extras.join('\n\n'), titleException }
+}
+const render = async (record, kind, mapping = {}, commentUrls = {}, extra = '', bodyLimit = limit) => {
+  const identity = migration.marker(kind, record.id)
+  const header = identity + '\n\n' + createMessage(record) + (extra ? '\n\n' + extra : '')
+  const text = await rewrite(record.body || '', mapping, commentUrls)
+  const body = header + '\n\n' + text
+  if (body.length <= bodyLimit) return { body, identity, parts: [] }
+  const raw = String(record.body || '')
+  const parts = []
+  let offset = 0
+  while (offset < raw.length) {
+    let end = Math.min(offset + 48000, raw.length)
+    if (end < raw.length) {
+      const newline = raw.lastIndexOf('\n', end)
+      if (newline > offset + 24000) end = newline + 1
+      if (raw.charCodeAt(end - 1) >= 0xD800 && raw.charCodeAt(end - 1) <= 0xDBFF) end--
+    }
+    parts.push(raw.slice(offset, end))
+    offset = end
+  }
+  return {
+    identity,
+    body: header + '\n\nThe original text exceeds GitHub’s creation limit. Its complete text is retained in the migration archive and is being restored after creation.',
+    parts,
+  }
+}
+const continuation = (record, kind, text, index, total) => {
+  const identity = migration.marker(kind + '-part-' + (index + 1), record.id)
+  return {
+    identity,
+    body: identity + '\n\n' + createMessage(record) + '\n\nOriginal Markdown, part ' + (index + 1) + ' of ' + total + '. Concatenate these parts in order to recover the complete original text.\n\n' + originalBlock(text),
+  }
+}
+module.exports = { render, continuation, originalBlock, objectPresentation, limit }
